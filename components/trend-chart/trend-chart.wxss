/* Trend chart */
.chart-container { padding: 8rpx 0; }
.chart-title { font-size: 26rpx; color: var(--text-secondary); font-weight: 500; letter-spacing: 1rpx; display: block; margin-bottom: 28rpx; }

.bars { display: flex; align-items: flex-end; gap: 16rpx; height: 200rpx; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-value { font-size: 22rpx; color: var(--text-secondary); display: block; margin-bottom: 8rpx; }
.bar-track { flex: 1; width: 100%; background: var(--border); border-radius: 8rpx; position: relative; overflow: hidden; }
.bar-fill { position: absolute; bottom: 0; width: 100%; border-radius: 8rpx; transition: height 0.5s; }
.bar-label { font-size: 22rpx; color: var(--text-tertiary); display: block; margin-top: 12rpx; }
