.chart-container { padding: 20rpx 0; }
.chart-title { font-size: 26rpx; color: #999; display: block; margin-bottom: 24rpx; }
.bars { display: flex; align-items: flex-end; gap: 20rpx; height: 200rpx; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-label { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.bar-track { flex: 1; width: 100%; background: #F5F5F5; border-radius: 8rpx; position: relative; }
.bar-fill { position: absolute; bottom: 0; width: 100%; border-radius: 8rpx; }
.bar-value { font-size: 22rpx; color: #666; }
