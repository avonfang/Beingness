/* Guide step v4 */
.guide-container { padding: var(--space-8) 0; }

.guide-progress { display: flex; align-items: center; gap: var(--space-8); margin-bottom: var(--space-12); }
.guide-step-label { font-size: var(--text-caption); color: var(--text-tertiary); width: 72rpx; font-weight: 500; }
.guide-track { flex: 1; height: 6rpx; background: var(--border); border-radius: 3rpx; overflow: hidden; }
.guide-fill { height: 100%; background: var(--gold); border-radius: 3rpx; transition: width 0.4s ease; }

.guide-bubble { background: var(--card); border-radius: var(--radius-md); padding: var(--space-24) var(--space-20); box-shadow: var(--shadow-md); position: relative; }
.guide-bubble::after { content: '🧘'; position: absolute; top: -24rpx; left: var(--space-20); font-size: var(--text-title); background: var(--card); padding: 0 var(--space-4); }

.guide-text { font-size: var(--text-subhead); color: var(--text); line-height: 2; display: block; white-space: pre-line; }

.guide-options { margin-top: var(--space-24); display: flex; flex-direction: column; gap: var(--space-12); }
.guide-option {
  background: var(--card); border: none;
  border-radius: var(--radius-sm); padding: var(--space-16) var(--space-20);
  text-align: center; box-shadow: var(--shadow-sm);
  transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
}
.guide-option:active { transform: scale(0.97); background: var(--primary-light); box-shadow: var(--shadow-md); }
.guide-option-text { font-size: var(--text-body-large); color: var(--text); display: block; font-weight: 500; }

.next-btn-area { margin-top: var(--space-24); text-align: center; }
