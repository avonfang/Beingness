/* Guide step */
.guide-container { padding: 24rpx 0; }

.guide-bubble { background: var(--card); border-radius: var(--radius-lg); padding: 52rpx 44rpx; box-shadow: var(--shadow-md); position: relative; }
.guide-bubble::after { content: '🧘'; position: absolute; top: -24rpx; left: 44rpx; font-size: 44rpx; background: var(--card); padding: 0 12rpx; }

.guide-progress { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.guide-step-label { font-size: 24rpx; color: var(--text-tertiary); width: 72rpx; }
.guide-track { flex: 1; height: 6rpx; background: var(--border); border-radius: 3rpx; overflow: hidden; }
.guide-fill { height: 100%; background: var(--gold); border-radius: 3rpx; transition: width 0.3s; }
.guide-text { font-size: 34rpx; color: var(--text); line-height: 2; display: block; white-space: pre-line; }

.guide-options { margin-top: 48rpx; display: flex; flex-direction: column; gap: 24rpx; }
.guide-option { background: var(--card); border: 2rpx solid var(--border); border-radius: var(--radius-md); padding: 36rpx 40rpx; text-align: center; transition: all 0.2s; }
.guide-option:active { border-color: var(--primary); background: var(--primary-light); transform: scale(0.98); }
.guide-option-text { font-size: 30rpx; color: var(--text); display: block; }

.next-btn-area { margin-top: 48rpx; text-align: center; }
.next-hint { display: inline-flex; align-items: center; gap: 8rpx; color: var(--primary); font-size: 30rpx; font-weight: 500; padding: 24rpx 48rpx; background: var(--primary-light); border-radius: var(--radius-xl); }
.next-hint:active { opacity: 0.7; }
