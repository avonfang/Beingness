<view class="guide-container">
  <view class="guide-progress" wx:if="{{totalSteps > 0}}">
    <text class="guide-step-label">{{stepIndex + 1}} / {{totalSteps}}</text>
    <view class="guide-track">
      <view class="guide-fill" style="width: {{(stepIndex + 1) / totalSteps * 100}}%"></view>
    </view>
  </view>
  <view class="guide-bubble">
    <text class="guide-text">{{text}}</text>
  </view>

  <view wx:if="{{options && options.length > 0}}" class="guide-options">
    <view
      class="guide-option"
      wx:for="{{options}}"
      wx:key="value"
      bindtap="onSelect"
      data-value="{{item.value}}"
    >
      <text class="guide-option-text">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{showNext}}" class="next-btn-area">
    <view class="next-hint" bindtap="onNext">
      <text>继续</text>
      <text>→</text>
    </view>
  </view>
</view>
