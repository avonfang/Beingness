.overlay {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(29, 26, 19, 0.7);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(12rpx);
}

.guide-card {
  background: #FFF; border-radius: 32rpx;
  width: 600rpx; padding: 64rpx 48rpx 48rpx;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.2);
  position: relative;
}

.dots { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 48rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #E8E5E0; }
.dot.active { width: 36rpx; border-radius: 12rpx; background: #C4A06A; }

.guide-content { text-align: center; min-height: 380rpx; }
.guide-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.guide-title { font-size: 40rpx; font-weight: 600; color: #1D1A13; display: block; }
.guide-desc { font-size: 28rpx; color: #8A8478; display: block; margin-top: 8rpx; }
.guide-body { font-size: 28rpx; color: #8A8478; line-height: 1.8; display: block; text-align: left; }

.feature-list { margin-top: 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.feature-item { display: flex; align-items: center; gap: 24rpx; text-align: left; }
.feature-icon { font-size: 40rpx; width: 60rpx; display: block; }
.feature-info { flex: 1; }
.feature-name { font-size: 30rpx; font-weight: 500; color: #1D1A13; display: block; }
.feature-desc { font-size: 26rpx; color: #8A8478; display: block; margin-top: 4rpx; }

.coin-list { margin-top: 32rpx; text-align: left; }
.coin-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid #F0EEEA; }
.coin-item:last-child { border-bottom: none; }
.coin-icon { font-size: 28rpx; color: #C4A06A; width: 40rpx; display: block; text-align: center; }
.coin-desc { font-size: 28rpx; color: #1D1A13; }

.guide-actions { margin-top: 48rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.btn-next {
  background: #C4A06A; color: #FFF; border-radius: 48rpx;
  padding: 24rpx 0; width: 100%; text-align: center;
  font-size: 30rpx; font-weight: 500;
}
.btn-next:active { opacity: 0.85; }
.btn-start {
  background: #C4A06A; color: #FFF; border-radius: 48rpx;
  padding: 24rpx 0; width: 100%; text-align: center;
  font-size: 30rpx; font-weight: 500;
}
.btn-start:active { opacity: 0.85; }
.btn-skip { font-size: 26rpx; color: #C4C0B8; padding: 8rpx 0; }
.btn-skip:active { opacity: 0.7; }
