<view class="overlay">
  <view class="guide-card">
    <view class="dots">
      <view class="dot {{step === 0 ? 'active' : ''}}"></view>
      <view class="dot {{step === 1 ? 'active' : ''}}"></view>
    </view>

    <view wx:if="{{step === 0}}" class="guide-content">
      <text class="guide-icon">🧘</text>
      <text class="guide-title">欢迎来到「此刻」</text>
      <text class="guide-desc">你的 AI 觉醒导师</text>
      <text class="guide-body" style="margin-top:24rpx">融合《当下的力量》《臣服实验》《清醒地活》三本经典的方法论，帮助你在情绪波动时回到当下。</text>
    </view>

    <view wx:if="{{step === 1}}" class="guide-content">
      <text class="guide-icon">✦</text>
      <text class="guide-title">从这里开始</text>
      <view class="step-list">
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-info">感觉不好时 → 点「现在感觉怎么样」开始急救</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-info">完成急救获得觉醒币，累积你的连续天数</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-info">用币深度对话，或学习课程深化觉醒</text>
        </view>
      </view>
    </view>

    <view class="guide-actions">
      <view wx:if="{{step < 1}}" class="btn-next" bindtap="next">
        <text>下一步</text>
      </view>
      <view wx:if="{{step === 1}}" class="btn-start" bindtap="finish">
        <text>开始体验</text>
      </view>
      <view class="btn-skip" bindtap="finish">
        {{step < 1 ? '跳过' : ''}}
      </view>
    </view>
  </view>
</view>
