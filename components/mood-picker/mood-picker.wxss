/* Mood picker v4 */
.picker-container { padding: var(--space-40) 0 var(--space-24); }
.picker-title { font-size: var(--text-title); font-weight: 500; color: var(--text); text-align: center; display: block; margin-bottom: var(--space-8); }
.picker-hint { font-size: var(--text-body); color: var(--text-secondary); text-align: center; display: block; margin-bottom: var(--space-24); }

.options-grid { display: flex; flex-wrap: wrap; gap: var(--space-12); justify-content: center; }

.option-item {
  width: 280rpx; padding: var(--space-20) var(--space-12);
  background: var(--card); border-radius: var(--radius-sm); text-align: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
}
.option-item:active { transform: scale(0.97); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.option-item.active { background: var(--primary-light); box-shadow: 0 8rpx 24rpx rgba(196,160,106,0.2); transform: scale(1.02); }

.option-icon { font-size: 60rpx; display: block; line-height: 1.2; }
.option-label { font-size: var(--text-body-large); color: var(--text); display: block; margin-top: var(--space-8); font-weight: 500; }
