<view class="page-bg"></view>

<view class="container">

  <!-- Header -->
  <view class="header">
    <view class="header-back" bindtap="finish">
      <text class="header-back-icon">←</text>
    </view>
    <text class="header-title serif">呼吸</text>
    <view class="header-right"></view>
  </view>

  <!-- Ready state -->
  <view wx:if="{{phase === 'ready'}}" class="ready-view">

    <!-- Breathing animation preview -->
    <view class="breath-preview">
      <view class="breath-ring breath-ring-3"></view>
      <view class="breath-ring breath-ring-2"></view>
      <view class="breath-ring breath-ring-1"></view>
      <view class="breath-center">
        <text class="breath-center-icon">{{phaseIcon}}</text>
      </view>
    </view>

    <text class="ready-title serif">{{currentPattern.name}}</text>
    <text class="ready-desc">{{currentPattern.desc}}</text>

    <!-- Pattern selector -->
    <scroll-view class="pattern-scroll" scroll-x enable-flex>
      <view
        class="pattern-chip {{selectedPattern === key ? 'active' : ''}} {{item.premium && !isPremium ? 'locked' : ''}}"
        wx:for="{{patternList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="selectPattern"
      >
        <text class="pattern-chip-icon">{{item.premium && !isPremium ? '🔒' : item.icon}}</text>
        <text class="pattern-chip-label">{{item.name}}</text>
        <text class="pattern-premium" wx:if="{{item.premium && !isPremium}}">无限</text>
      </view>
    </scroll-view>

    <!-- Round selector -->
    <view class="round-select">
      <text class="round-label">轮次</text>
      <view class="round-options">
        <view
          class="round-opt {{targetRounds === n ? 'active' : ''}}"
          wx:for="{{[3, 6, 9]}}"
          wx:key="*this"
          data-n="{{item}}"
          bindtap="setTarget"
        >{{item}}</view>
      </view>
    </view>

    <view class="btn btn-primary start-btn" bindtap="start">开始练习</view>
  </view>

  <!-- Running state -->
  <view wx:if="{{phase === 'running'}}" class="running-view">
    <view class="breath-animation-box">
      <view class="breath-glow {{phaseLabel}}"></view>
      <view class="breath-circle-animated {{phaseLabel}}">
        <text class="breath-circle-icon">{{currentPattern.icon}}</text>
      </view>
    </view>

    <text class="phase-label-text">{{phaseLabel}}</text>
    <text class="countdown-num">{{countdown}}</text>

    <view class="progress-track">
      <view class="progress-fill" style="width: {{timerProgress}}%"></view>
    </view>

    <text class="round-text">第 {{currentRound}} / {{targetRounds}} 轮</text>
  </view>

  <!-- Done state -->
  <view wx:if="{{phase === 'done'}}" class="done-view">
    <view class="breath-preview">
      <view class="breath-ring breath-ring-1" style="animation: breatheIn 2.5s ease-in-out infinite;"></view>
      <view class="breath-ring breath-ring-2" style="animation: breatheIn 2.5s ease-in-out infinite 0.3s;"></view>
      <view class="breath-center">
        <text class="breath-center-icon">🌿</text>
      </view>
    </view>
    <text class="done-title serif">练习完成</text>
    <text class="done-desc">每一次呼吸，都是回到当下的一步。</text>
    <view class="done-actions">
      <view class="btn btn-primary start-btn" bindtap="restart">再来一次</view>
      <view class="btn btn-ghost" bindtap="finish">完成</view>
    </view>
  </view>

</view>
