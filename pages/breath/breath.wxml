<view class="container {{themeClass}}">
  <!-- Pattern selector -->
  <view class="pattern-selector" wx:if="{{phase === 'ready'}}">
    <view class="pattern-tag {{selectedPattern === key ? 'active' : ''}} {{item.premium && !isPremium ? 'locked' : ''}}" wx:for="{{patterns}}" wx:key="key" data-key="{{key}}" bindtap="selectPattern">
      <text>{{item.premium && !isPremium ? '🔒' : item.icon}} {{item.name}}</text>
      <text class="premium-badge" wx:if="{{item.premium && !isPremium}}">无限版</text>
    </view>
  </view>

  <!-- Ready state -->
  <view class="ready-area" wx:if="{{phase === 'ready'}}">
    <view class="breath-circle idle">
      <text class="breath-icon">{{phaseIcon}}</text>
    </view>
    <view class="round-selector">
      <text class="round-label">练习轮数</text>
      <view class="round-options">
        <view class="round-opt {{targetRounds === 3 ? 'active' : ''}}" data-n="3" bindtap="setTarget">3</view>
        <view class="round-opt {{targetRounds === 6 ? 'active' : ''}}" data-n="6" bindtap="setTarget">6</view>
        <view class="round-opt {{targetRounds === 10 ? 'active' : ''}}" data-n="10" bindtap="setTarget">10</view>
      </view>
    </view>
    <view class="start-btn-area">
      <view class="btn btn-primary btn-lg" bindtap="start">开始练习</view>
    </view>
  </view>

  <!-- Running state -->
  <view class="running-area" wx:if="{{phase === 'inhale'}}">
    <view class="breath-ring-wrap">
      <view class="breath-ring" style="animation-duration: {{phaseDuration * 2}}s"></view>
      <view class="breath-circle animating" style="animation-duration: {{phaseDuration * 2}}s">
        <text class="breath-countdown">{{countdown}}</text>
        <text class="breath-label">{{phaseLabel}}</text>
      </view>
    </view>
    <view class="progress-info">
      <text class="round-indicator">第 {{currentRound}} / {{targetRounds}} 轮</text>
      <view class="progress-dots">
        <view class="progress-dot {{i < currentRound ? 'done' : ''}}" wx:for="{{targetRounds}}" wx:key="index"></view>
      </view>
    </view>
  </view>

  <!-- Done state -->
  <view class="done-area" wx:if="{{phase === 'done'}}">
    <view class="breath-circle done">
      <text class="breath-icon">✨</text>
    </view>
    <text class="done-title">练习完成</text>
    <text class="done-desc">你完成了 {{totalRounds}} 轮呼吸</text>
    <text class="done-coin">+1 觉醒币</text>
    <view class="done-actions">
      <view class="btn btn-outline btn-md" bindtap="restart">再来一次</view>
      <view class="btn btn-primary btn-md" bindtap="finish">完成</view>
    </view>
    <button class="btn btn-outline btn-sm" open-type="share" style="margin-top: var(--space-12)">分享此刻</button>
  </view>
</view>
