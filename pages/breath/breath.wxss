/* Breath v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; align-items: center; }

.pattern-selector { display: flex; gap: var(--space-8); flex-wrap: wrap; justify-content: center; margin-top: var(--space-20); animation: fadeInUp 0.35s ease-out both; }
.pattern-tag {
  padding: var(--space-8) var(--space-16); border-radius: var(--radius-lg);
  font-size: var(--text-body); background: var(--card);
  border: 2rpx solid var(--border-light); color: var(--text-secondary);
  transition: transform 0.12s, border-color 0.2s;
}
.pattern-tag.active { border-color: var(--gold); color: var(--gold); background: var(--gold-light); }
.pattern-tag:active { transform: scale(0.95); }

/* Breath circle */
.breath-circle {
  width: 360rpx; height: 360rpx; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin: var(--space-40) auto; transition: all 0.3s;
}
.breath-circle.idle { background: var(--gold-light); box-shadow: 0 0 0 0 rgba(196,160,106,0); }
.breath-circle.done { background: var(--gold-light); animation: bounceIn 0.5s ease-out both; box-shadow: 0 0 32rpx 8rpx rgba(196,160,106,0.2); }
.breath-circle.animating { background: linear-gradient(135deg, #FFF 0%, var(--gold-light) 100%); animation: breathe 4s ease-in-out infinite; margin: 0 auto; }
.breath-icon { font-size: 72rpx; display: block; }
.breath-countdown { font-size: 96rpx; font-weight: 300; color: var(--primary); display: block; line-height: 1; }
.breath-label { font-size: var(--space-16); color: var(--text); display: block; margin-top: var(--space-2); font-weight: 500; }

.breath-ring-wrap { position: relative; display: flex; align-items: center; justify-content: center; margin: var(--space-40) auto; }
.breath-ring {
  position: absolute; width: 360rpx; height: 360rpx; border-radius: 50%;
  border: 2rpx solid rgba(196,160,106,0.15);
  animation: ring-pulse 4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes ring-pulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.25); opacity: 0; }
}
@keyframes breathe {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(196,160,106,0.05); }
  50% { transform: scale(1.15); box-shadow: 0 0 60rpx 20rpx rgba(196,160,106,0.12); }
}

/* Round selector */
.round-selector { text-align: center; margin-bottom: var(--space-20); }
.round-label { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-bottom: var(--space-8); }
.round-options { display: flex; gap: var(--space-8); justify-content: center; }
.round-opt {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  border: 2rpx solid var(--border-light); display: flex; align-items: center; justify-content: center;
  font-size: var(--text-body-large); color: var(--text-secondary); background: var(--card);
  transition: transform 0.12s, border-color 0.2s;
}
.round-opt.active { border-color: var(--gold); color: var(--gold); background: var(--gold-light); transform: scale(1.08); }
.round-opt:active { transform: scale(0.92); }

/* Running */
.running-area { width: 100%; display: flex; flex-direction: column; align-items: center; }
.progress-info { text-align: center; }
.round-indicator { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-bottom: var(--space-8); }
.progress-dots { display: flex; gap: var(--space-4); justify-content: center; }
.progress-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--border); transition: transform 0.2s, background 0.2s; }
.progress-dot.done { background: var(--gold); transform: scale(1.2); }

/* Done */
.done-area { text-align: center; padding-top: var(--space-40); }
.done-title { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; margin-top: var(--space-8); }
.done-desc { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-4); }
.done-coin { font-size: var(--space-16); color: var(--gold); font-weight: 500; display: block; margin-top: var(--space-12); }
.done-actions { display: flex; gap: var(--space-12); margin-top: var(--space-24); justify-content: center; }
