/* Breath v7 — 疗愈风格 */
.container {
  min-height: 100vh;
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; align-items: center;
  position: relative; z-index: 1;
}

/* Header */
.header {
  width: 100%;
  display: flex; align-items: center; justify-content: space-between;
  padding: 48rpx 0 24rpx;
}
.header-back { padding: 8rpx; }
.header-back:active { opacity: 0.5; }
.header-back-icon { font-size: 36rpx; color: var(--text-secondary); }
.header-title { font-size: 36rpx; color: var(--text); letter-spacing: 2rpx; }
.header-right { width: 44rpx; }

/* ====== 呼吸动画预览 (idle) ====== */
.breath-preview {
  position: relative;
  width: 360rpx; height: 360rpx;
  display: flex; align-items: center; justify-content: center;
  margin: 48rpx auto 32rpx;
}
.breath-ring {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.breath-ring-3 {
  width: 360rpx; height: 360rpx;
  border: 2rpx solid rgba(196,160,106,0.08);
  animation: breatheIn 4s ease-in-out infinite;
}
.breath-ring-2 {
  width: 300rpx; height: 300rpx;
  border: 2rpx solid rgba(196,160,106,0.12);
  animation: breatheIn 4s ease-in-out infinite 0.3s;
}
.breath-ring-1 {
  width: 240rpx; height: 240rpx;
  background: rgba(196,160,106,0.06);
  animation: breatheIn 4s ease-in-out infinite 0.6s;
}
.breath-center {
  position: absolute;
  width: 160rpx; height: 160rpx;
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(12rpx);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(196,160,106,0.1);
}
.breath-center-icon { font-size: 64rpx; display: block; }

@keyframes breatheIn {
  0%, 100% { transform: scale(0.9); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 1; }
}

/* Ready state */
.ready-view {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  animation: fadeUp 0.4s ease both;
}
.ready-title {
  font-size: 38rpx; color: var(--text);
  display: block; margin-bottom: 8rpx;
}
.ready-desc {
  font-size: 24rpx; color: var(--text-tertiary);
  display: block; margin-bottom: 32rpx;
}

/* Pattern chips */
.pattern-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 32rpx;
  padding-bottom: 8rpx;
}
.pattern-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 48rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}
.pattern-chip:active { transform: scale(0.95); }
.pattern-chip.active {
  background: rgba(255,255,255,0.9);
  border-color: var(--primary);
  box-shadow: 0 2rpx 12rpx rgba(196,160,106,0.15);
}
.pattern-chip.locked { opacity: 0.5; }
.pattern-chip-icon { font-size: 32rpx; }
.pattern-chip-label { font-size: 26rpx; color: var(--text-secondary); font-weight: 500; }
.pattern-chip.active .pattern-chip-label { color: var(--text); }
.pattern-premium {
  font-size: 18rpx; color: var(--primary);
  background: var(--primary-subtle);
  padding: 2rpx 10rpx; border-radius: 12rpx;
  margin-left: 4rpx;
}

/* Round selector */
.round-select {
  display: flex; align-items: center;
  gap: 20rpx; margin-bottom: 40rpx;
}
.round-label { font-size: 26rpx; color: var(--text-secondary); display: block; }
.round-options { display: flex; gap: 12rpx; }
.round-opt {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--text-secondary);
  background: rgba(255,255,255,0.4);
  transition: all 0.2s;
}
.round-opt.active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(255,255,255,0.9);
  transform: scale(1.08);
  box-shadow: 0 2rpx 12rpx rgba(196,160,106,0.15);
}
.round-opt:active { transform: scale(0.95); }

.start-btn {
  padding: 20rpx 80rpx;
  font-size: 30rpx;
  border-radius: 56rpx;
}

/* ====== Running state ====== */
.running-view {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  padding-top: 80rpx;
  animation: fadeUp 0.3s ease both;
}
.breath-animation-box {
  position: relative;
  width: 400rpx; height: 400rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 40rpx;
}
.breath-glow {
  position: absolute;
  width: 400rpx; height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196,160,106,0.15) 0%, transparent 70%);
}
.breath-glow.inhale { animation: glowPulse 4s ease-in-out infinite; }
.breath-glow.exhale { animation: glowPulse 6s ease-in-out infinite; }
.breath-glow.hold { animation: glowPulse 3s ease-in-out infinite; }

.breath-circle-animated {
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(16rpx);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(196,160,106,0.12);
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.breath-circle-animated.inhale {
  animation: circleInhale 4s ease-in-out infinite;
}
.breath-circle-animated.exhale {
  animation: circleExhale 6s ease-in-out infinite;
}
.breath-circle-animated.hold {
  animation: circleHold 3s ease-in-out infinite;
}
.breath-circle-icon { font-size: 72rpx; display: block; }

@keyframes glowPulse {
  0%, 100% { transform: scale(0.85); opacity: 0.3; }
  50% { transform: scale(1.2); opacity: 0.8; }
}
@keyframes circleInhale {
  0%, 100% { transform: scale(0.9); }
  50% { transform: scale(1.15); box-shadow: 0 12rpx 60rpx rgba(196,160,106,0.2); }
}
@keyframes circleExhale {
  0%, 100% { transform: scale(0.85); }
  50% { transform: scale(1.05); }
}
@keyframes circleHold {
  0%, 100% { transform: scale(1.08); opacity: 0.8; }
  50% { transform: scale(1); opacity: 1; }
}

.phase-label-text {
  font-size: 36rpx;
  color: var(--text);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.countdown-num {
  font-size: 96rpx;
  font-weight: 200;
  color: var(--primary);
  display: block;
  line-height: 1;
  margin-bottom: 32rpx;
}

.progress-track {
  width: 280rpx;
  height: 6rpx;
  background: rgba(196,160,106,0.12);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 3rpx;
  transition: width 0.3s linear;
}
.round-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
}

/* ====== Done state ====== */
.done-view {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  padding-top: 80rpx;
  animation: fadeUp 0.4s ease both;
}
.done-title {
  font-size: 42rpx; color: var(--text);
  display: block; margin-top: 24rpx;
}
.done-desc {
  font-size: 26rpx; color: var(--text-secondary);
  display: block; margin-top: 12rpx; margin-bottom: 48rpx;
  text-align: center;
  padding: 0 40rpx;
}
.done-actions {
  display: flex; flex-direction: column;
  align-items: center; gap: 20rpx;
  width: 100%;
}

.btn-ghost {
  background: transparent; color: var(--text-tertiary);
  border: none; padding: 16rpx 32rpx;
}
.btn-ghost:active { opacity: 0.5; }
