/* Lesson detail */
.container { min-height: 100vh; padding: 0 36rpx; }
.lesson-header { padding: 48rpx 0 36rpx; border-bottom: 2rpx solid var(--border); margin-bottom: 36rpx; }
.lesson-num { font-size: 26rpx; color: var(--primary); letter-spacing: 2rpx; display: block; }
.lesson-title { font-size: 44rpx; font-weight: 600; color: var(--text); display: block; margin-top: 8rpx; }
.lesson-subtitle { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 8rpx; }
.content-area { height: calc(100vh - 240rpx); padding-bottom: 48rpx; }

.section { background: var(--card); border-radius: var(--radius-md); padding: 40rpx 36rpx; margin-bottom: 28rpx; box-shadow: var(--shadow-sm); }
.section-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.section-icon { font-size: 36rpx; display: block; }
.section-label { font-size: 28rpx; color: var(--primary); font-weight: 500; letter-spacing: 2rpx; display: block; }
.section-text { font-size: 30rpx; color: var(--text-secondary); line-height: 2; display: block; white-space: pre-line; }

.lesson-actions { margin-top: 36rpx; display: flex; flex-direction: column; gap: 24rpx; }
.practice-btn { background: var(--primary); color: #FFF; border-radius: var(--radius-xl); padding: 32rpx 0; font-size: 32rpx; font-weight: 500; border: none; width: 100%; }
.practice-btn:active { opacity: 0.85; }

.complete-btn { background: transparent; color: var(--primary); border: 2rpx solid var(--primary); border-radius: var(--radius-xl); padding: 32rpx 0; font-size: 32rpx; font-weight: 500; width: 100%; }
.complete-btn:active { opacity: 0.7; }
.complete-btn[disabled] { background: var(--border); color: var(--text-tertiary); border-color: transparent; }
.next-btn { background: transparent; color: var(--primary); border: 2rpx solid var(--primary); border-radius: var(--radius-xl); padding: 32rpx 0; font-size: 32rpx; width: 100%; }
.next-btn:active { opacity: 0.7; }
