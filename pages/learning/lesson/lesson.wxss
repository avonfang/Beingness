/* Lesson v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); }
.lesson-header { padding: var(--space-24) 0 var(--space-16); border-bottom: 2rpx solid var(--border-light); margin-bottom: var(--space-16); }
.lesson-num { font-size: var(--text-caption); color: var(--primary); letter-spacing: 2rpx; display: block; font-weight: 500; }
.lesson-title { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; margin-top: var(--space-2); }
.lesson-subtitle { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-2); }
.content-area { height: calc(100vh - 240rpx); padding-bottom: var(--space-24); }

.section { background: var(--card); border-radius: var(--radius-sm); padding: var(--space-20) var(--space-16); margin-bottom: var(--space-12); box-shadow: var(--shadow-sm); }
.section-header { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-8); }
.section-icon { font-size: var(--text-headline); display: block; }
.section-label { font-size: var(--text-body); color: var(--primary); font-weight: 600; letter-spacing: 2rpx; display: block; }
.section-text { font-size: var(--text-body); color: var(--text-secondary); line-height: 2; display: block; white-space: pre-line; }

.lesson-actions { margin-top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-12); }
