/* Lesson v5 — card-based, swipeable */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; }

.lesson-header { padding: var(--space-20) 0 var(--space-12); flex-shrink: 0; }
.lesson-num { font-size: var(--text-caption); color: var(--primary); letter-spacing: 2rpx; display: block; font-weight: 500; }
.lesson-title { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; margin-top: var(--space-2); }
.lesson-subtitle { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-2); }

/* Card area — fills remaining space */
.card-area { flex: 1; position: relative; display: flex; flex-direction: column; justify-content: center; min-height: 0; }

/* Slide cards — stacked, only active one is visible */
.slide-card { position: absolute; inset: 0; pointer-events: none; }
.slide-card-inner {
  background: var(--card); border-radius: var(--radius-md); padding: var(--space-24) var(--space-20);
  box-shadow: var(--shadow-sm); height: 100%; display: flex; flex-direction: column;
  opacity: 0; transform: translateX(40rpx); transition: opacity 0.3s ease, transform 0.3s ease;
  overflow-y: auto; pointer-events: none;
}
.slide-card-inner.active { opacity: 1; transform: translateX(0); pointer-events: auto; }

.slide-icon { font-size: 64rpx; display: block; margin-bottom: var(--space-8); }
.slide-type-label {
  font-size: var(--text-caption); color: var(--primary); font-weight: 600;
  letter-spacing: 2rpx; display: block; margin-bottom: var(--space-12);
}
.slide-text-wrap { flex: 1; display: flex; flex-direction: column; }
.slide-text {
  font-size: var(--text-body); color: var(--text-secondary); line-height: 2;
  display: block; white-space: pre-line; flex: 1;
}

/* Actions in the practice slide */
.slide-actions { margin-top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-8); flex-shrink: 0; }

/* Navigation dots */
.slide-dots {
  display: flex; justify-content: center; gap: var(--space-4);
  padding: var(--space-12) 0; flex-shrink: 0; z-index: 2; position: relative;
}
.slide-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--border);
  transition: background 0.2s, transform 0.2s;
}
.slide-dot.active { background: var(--gold); transform: scale(1.3); }

/* Tap zones for prev/next */
.nav-zones { position: fixed; inset: 0; display: flex; pointer-events: none; z-index: 1; }
.nav-zone-left, .nav-zone-right {
  flex: 1; display: flex; align-items: center; justify-content: center; pointer-events: auto;
}
.nav-arrow {
  font-size: 80rpx; color: var(--text-tertiary); opacity: 0.3;
  width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center;
  transition: opacity 0.2s;
}
.nav-zone-left:active .nav-arrow, .nav-zone-right:active .nav-arrow { opacity: 0.6; }
