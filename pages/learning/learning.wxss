/* Learning v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); }

.path-card {
  background: var(--card); border-radius: var(--radius-sm); padding: var(--space-20) var(--space-16);
  margin-bottom: var(--space-16); box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
  transition: transform 0.15s, box-shadow 0.15s;
}
.path-card:active { transform: scale(0.97); box-shadow: var(--shadow-md); }
.path-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6rpx; }
.path-card.presence::before { background: var(--primary); }
.path-card.surrender::before { background: var(--gold); }
.path-card.openness::before { background: #B8A5C4; }

.path-header { display: flex; align-items: center; gap: var(--space-12); }
.path-icon { font-size: var(--text-hero); display: block; line-height: 1; }
.path-info { flex: 1; }
.path-title { font-size: var(--text-headline); font-weight: 600; color: var(--text); display: block; }
.path-subtitle { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-2); }

.path-progress { display: flex; align-items: center; gap: var(--space-8); margin-top: var(--space-16); }
.progress-bar { flex: 1; height: 10rpx; background: var(--border); border-radius: 5rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 5rpx; transition: width 0.6s ease; }
.path-card.presence .progress-fill { background: var(--primary); }
.path-card.surrender .progress-fill { background: var(--gold); }
.path-card.openness .progress-fill { background: #B8A5C4; }
.progress-text { font-size: var(--text-caption); color: var(--text-tertiary); min-width: 70rpx; text-align: right; font-weight: 500; }

.path-source { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-12); padding-top: var(--space-12); border-top: 2rpx solid var(--border-light); }
