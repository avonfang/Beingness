/* Learning paths */
.container { min-height: 100vh; padding: 0 36rpx; }
.page-header { padding: 48rpx 0 36rpx; }
.page-title { font-size: 44rpx; font-weight: 600; color: var(--text); display: block; }
.page-subtitle { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 8rpx; }

.path-card { background: var(--card); border-radius: var(--radius-lg); padding: 44rpx 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-md); position: relative; overflow: hidden; }
.path-card:active { opacity: 0.95; }
.path-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx; }
.path-card.presence::before { background: var(--primary); }
.path-card.surrender::before { background: var(--gold); }
.path-card.openness::before { background: #B8A5C4; }

.path-header { display: flex; align-items: center; gap: 24rpx; }
.path-icon { font-size: 52rpx; display: block; line-height: 1; }
.path-info { flex: 1; }
.path-title { font-size: 38rpx; font-weight: 600; color: var(--text); display: block; }
.path-subtitle { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 8rpx; }

.path-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; }
.progress-bar { flex: 1; height: 10rpx; background: var(--border); border-radius: 5rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 5rpx; transition: width 0.5s; }
.path-card.presence .progress-fill { background: var(--primary); }
.path-card.surrender .progress-fill { background: var(--gold); }
.path-card.openness .progress-fill { background: #B8A5C4; }
.progress-text { font-size: 26rpx; color: var(--text-tertiary); min-width: 70rpx; text-align: right; }

.path-source { font-size: 26rpx; color: var(--text-tertiary); display: block; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid var(--border); }
