<view class="container {{themeClass}}">
  <view class="page-header fade-up">
    <text class="page-title">练习</text>
    <text class="page-subtitle">今天该看的东西</text>
  </view>

  <view class="random-btn fade-up-d1" bindtap="randomLesson">
    <text class="random-btn-icon">🎲</text>
    <text class="random-btn-label">随便逛逛</text>
    <text class="random-btn-arrow">→</text>
  </view>

  <view class="lesson-list">
    <view class="lesson-card {{item.completed ? 'done' : ''}} fade-up-d2" wx:for="{{lessons}}" wx:key="id" bindtap="openLesson" data-key="{{item.key}}" data-lessonindex="{{item.lessonIndex}}">
      <view class="lesson-card-header">
        <text class="lesson-card-icon">{{item.icon}}</text>
        <view class="lesson-card-info">
          <text class="lesson-card-title">{{item.title}}</text>
          <text class="lesson-card-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="lesson-card-badge" wx:if="{{item.completed}}">✓</text>
      </view>
      <text class="lesson-card-source">{{item.source}}</text>
    </view>
  </view>
</view>
