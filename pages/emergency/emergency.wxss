/* Emergency v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; }
.picker-container, .guide-container, .complete-view { animation: fadeInUp 0.35s ease-out both; }

.complete-view { display: flex; flex-direction: column; align-items: center; padding-top: var(--space-12); flex: 1; }
.complete-icon { font-size: 88rpx; display: block; margin-bottom: var(--space-16); animation: bounceIn 0.5s ease-out both; }
.complete-title { font-size: var(--text-title); color: var(--text); font-weight: 600; display: block; }
.complete-desc { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-4); }

.note-section { width: 100%; margin-top: var(--space-24); }
.note-input {
  width: 100%; height: 200rpx; background: var(--card);
  border-radius: var(--radius-sm); padding: var(--space-16);
  font-size: var(--text-body); color: var(--text);
  box-sizing: border-box; border: 2rpx solid var(--border); line-height: 1.8;
  transition: border-color 0.2s;
}
.note-input:focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(196,160,106,0.1); }

/* Star rating */
.rating-area { width: 100%; margin-top: var(--space-24); text-align: center; }
.rating-label { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-bottom: var(--space-8); }
.stars { display: flex; justify-content: center; gap: var(--space-8); }
.star {
  font-size: 64rpx; color: var(--border); line-height: 1;
  padding: var(--space-2); transition: transform 0.2s, color 0.15s;
  display: inline-block;
}
.star.active { color: var(--gold); }
.star:active { transform: scale(0.85); }

/* Buttons — 使用 btn 系统 */
.save-btn { width: 80%; margin-top: var(--space-32); }
.dialogue-btn { width: 80%; margin-top: var(--space-24); }
.share-btn { width: 80%; margin-top: var(--space-8); }
.back-btn { width: 80%; background: transparent; color: var(--text-tertiary); border: none; padding: var(--space-12) 0; font-size: var(--text-body); margin-top: var(--space-4); }
.back-btn:active { opacity: 0.6; }

/* Crisis — 无边框用纯色背景 */
.crisis-card {
  width: 80%; background: #FFF5F0; border-radius: var(--radius-sm);
  padding: var(--space-12); margin-top: var(--space-16); text-align: center;
}
.crisis-text { font-size: var(--text-caption); color: #B8654A; line-height: 1.8; display: block; }

/* Ambient */
.ambient-circle {
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  border-radius: 50%; position: fixed; top: 10%; right: -60rpx; opacity: 0.5; z-index: 0;
}
