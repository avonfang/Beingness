/* Emergency v2 */
.container { min-height: 100vh; padding: 0 36rpx; display: flex; flex-direction: column; }

/* Phase containers get fade-in */
.picker-container, .guide-container, .complete-view { animation: fadeInUp 0.35s ease-out both; }

/* Complete view */
.complete-view { display: flex; flex-direction: column; align-items: center; padding-top: 40rpx; flex: 1; justify-content: flex-start; }
.complete-icon { font-size: 88rpx; display: block; margin-bottom: 36rpx; animation: bounceIn 0.5s ease-out both; }
.complete-title { font-size: 38rpx; color: var(--text); font-weight: 600; display: block; }
.complete-desc { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 12rpx; }

.note-section { width: 100%; margin-top: 48rpx; }
.note-input { width: 100%; height: 200rpx; background: var(--card); border-radius: var(--radius-md); padding: 32rpx; font-size: 30rpx; color: var(--text); box-sizing: border-box; border: 2rpx solid var(--border); line-height: 1.8; transition: border-color 0.2s; }
.note-input:focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(196,160,106,0.1); }

/* Star rating */
.rating-area { width: 100%; margin-top: 48rpx; text-align: center; }
.rating-label { font-size: 28rpx; color: var(--text-secondary); display: block; margin-bottom: 20rpx; }
.stars { display: flex; justify-content: center; gap: 16rpx; }
.star {
  font-size: 64rpx; color: var(--border); line-height: 1;
  padding: 8rpx; transition: transform 0.2s, color 0.15s;
  display: inline-block;
}
.star.active { color: var(--gold); }
.star:active { transform: scale(0.85); }

/* Buttons */
.save-btn {
  width: 80%; background: var(--primary); color: #FFF;
  border-radius: var(--radius-xl); padding: 32rpx 0;
  font-size: 32rpx; font-weight: 500; margin-top: 60rpx; border: none;
  transition: transform 0.12s, box-shadow 0.12s;
}
.save-btn:active { transform: scale(0.97); box-shadow: 0 4rpx 16rpx rgba(196,160,106,0.35); }

.dialogue-btn {
  width: 80%; background: transparent; color: var(--primary);
  border: 2rpx solid var(--primary); border-radius: var(--radius-xl);
  padding: 32rpx 0; font-size: 32rpx; margin-top: 48rpx;
  transition: transform 0.12s, background 0.15s;
}
.dialogue-btn:active { transform: scale(0.97); background: var(--primary-light); }

.share-btn {
  width: 80%; background: transparent; color: var(--primary);
  border: 2rpx dashed var(--border); border-radius: var(--radius-xl);
  padding: 32rpx 0; font-size: 28rpx; margin-top: 20rpx;
  transition: transform 0.12s;
}
.share-btn:active { transform: scale(0.97); border-color: var(--primary); }

.back-btn { width: 80%; background: transparent; color: var(--text-tertiary); border: none; padding: 28rpx 0; font-size: 28rpx; margin-top: 20rpx; }
.back-btn:active { opacity: 0.6; }

/* Crisis card */
.crisis-card { width: 80%; background: #FFF5F0; border: 2rpx solid #FFD4C0; border-radius: var(--radius-md); padding: 28rpx; margin-top: 32rpx; text-align: center; }
.crisis-text { font-size: 24rpx; color: #B8654A; line-height: 1.8; display: block; }

/* Ambient */
.ambient-circle { width: 200rpx; height: 200rpx; background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%); border-radius: 50%; position: fixed; top: 10%; right: -60rpx; opacity: 0.5; z-index: 0; }

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes bounceIn {
  0%   { transform: scale(0.6); }
  60%  { transform: scale(1.15); }
  100% { transform: scale(1); }
}
