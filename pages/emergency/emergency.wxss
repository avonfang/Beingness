/* Emergency v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; }
.picker-container, .guide-container, .complete-view { animation: fadeInUp 0.35s ease-out both; }

.complete-view { display: flex; flex-direction: column; align-items: center; padding-top: var(--space-12); flex: 1; }

/* Celebratory completion — Apple-style achievement moment */
.done-celebration { position: relative; width: 180rpx; height: 180rpx; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-16); }
.done-glow {
  position: absolute; width: 180rpx; height: 180rpx;
  background: radial-gradient(circle, rgba(196,160,106,0.25) 0%, transparent 70%);
  border-radius: 50%; animation: celebrateGlow 1.2s ease-out both;
}
@keyframes celebrateGlow {
  0% { transform: scale(0.6); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.8; }
  100% { transform: scale(1); opacity: 0.5; }
}
.complete-icon { font-size: 88rpx; display: block; position: relative; z-index: 1; animation: bounceIn 0.5s ease-out both; }
.complete-title { font-size: var(--text-title); color: var(--text); font-weight: 600; display: block; }
.complete-desc { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-4); }

.note-section { width: 100%; margin-top: var(--space-24); }
.note-input {
  width: 100%; height: 200rpx; background: var(--card);
  border-radius: var(--radius-sm); padding: var(--space-16);
  font-size: var(--text-body); color: var(--text);
  box-sizing: border-box; border: 2rpx solid var(--border); line-height: 1.8;
  transition: border-color 0.2s;
}
.note-input:focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(196,160,106,0.1); }

/* Star rating */
.rating-area { width: 100%; margin-top: var(--space-24); text-align: center; }
.rating-label { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-bottom: var(--space-12); }
.stars { display: flex; justify-content: center; gap: var(--space-12); }
.star {
  font-size: 72rpx; color: var(--border); line-height: 1;
  padding: var(--space-4); transition: transform 0.15s, color 0.2s;
  display: inline-block;
}
.star.active { color: var(--gold); transform: scale(1.1); }
.star:active { transform: scale(0.8); }

/* Crisis */
.crisis-card {
  width: 80%; background: var(--accent-warm-bg); border-radius: var(--radius-sm);
  padding: var(--space-12); margin-top: var(--space-16); text-align: center;
}
.crisis-text { font-size: var(--text-caption); color: var(--accent-warm-text); line-height: 1.8; display: block; }

/* Guide back nav */
.guide-header { animation: fadeInUp 0.35s ease-out both; }
.guide-back {
  display: flex; align-items: center; gap: var(--space-4); padding: var(--space-8) 0;
  transition: transform 0.12s;
}
.guide-back:active { transform: scale(0.97); }
.guide-back-icon { font-size: var(--space-16); color: var(--text-secondary); }
.guide-back-label { font-size: var(--text-caption); color: var(--text-secondary); }

/* Ambient */
.ambient-circle {
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  border-radius: 50%; position: fixed; top: 10%; right: -60rpx; opacity: 0.5; z-index: 0;
}
