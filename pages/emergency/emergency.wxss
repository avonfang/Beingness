/* Emergency */
.container { min-height: 100vh; padding: 0 36rpx; display: flex; flex-direction: column; }
.step-indicator { display: flex; justify-content: center; align-items: center; gap: 16rpx; padding: 160rpx 0 48rpx; }
.step-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--border); transition: all 0.3s; }
.step-dot.active { width: 48rpx; height: 12rpx; border-radius: 12rpx; background: var(--primary); }

.complete-view { display: flex; flex-direction: column; align-items: center; padding-top: 40rpx; flex: 1; justify-content: flex-start; }
.complete-icon { font-size: 88rpx; display: block; margin-bottom: 36rpx; }
.complete-title { font-size: 38rpx; color: var(--text); font-weight: 500; display: block; }
.complete-desc { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 12rpx; }

.note-section { width: 100%; margin-top: 48rpx; }
.note-input { width: 100%; height: 200rpx; background: var(--card); border-radius: var(--radius-md); padding: 32rpx; font-size: 30rpx; color: var(--text); box-sizing: border-box; border: 2rpx solid var(--border); line-height: 1.8; }
.note-input:focus { border-color: var(--primary); }

.rating-area { width: 100%; margin-top: 48rpx; text-align: center; }
.rating-label { font-size: 28rpx; color: var(--text-secondary); display: block; margin-bottom: 20rpx; }
.stars { display: flex; justify-content: center; gap: 16rpx; }
.star { font-size: 64rpx; color: var(--border); line-height: 1; transition: color 0.2s; padding: 8rpx; }
.star.active { color: var(--gold); }

.save-btn { width: 80%; background: var(--primary); color: #FFF; border-radius: var(--radius-xl); padding: 32rpx 0; font-size: 32rpx; font-weight: 500; margin-top: 60rpx; border: none; }
.save-btn:active { opacity: 0.85; }

.dialogue-btn { width: 80%; background: transparent; color: var(--primary); border: 2rpx solid var(--primary); border-radius: var(--radius-xl); padding: 32rpx 0; font-size: 32rpx; margin-top: 48rpx; }
.dialogue-btn:active { opacity: 0.7; }

.back-btn { width: 80%; background: transparent; color: var(--text-tertiary); border: none; padding: 28rpx 0; font-size: 28rpx; margin-top: 20rpx; }

.ambient-circle { width: 200rpx; height: 200rpx; background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%); border-radius: 50%; position: fixed; top: 10%; right: -60rpx; opacity: 0.5; z-index: 0; }
