/* Home page v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; }

/* Header */
.header-bar { display: flex; align-items: center; justify-content: space-between; padding: var(--space-16) 0 var(--space-12); }
.logo-word { font-size: var(--text-headline); font-weight: 600; color: var(--text); letter-spacing: 4rpx; }
.header-right { display: flex; align-items: center; gap: var(--space-8); }
.streak-badge {
  font-size: var(--text-caption); color: var(--text-secondary); background: var(--card);
  padding: var(--space-2) var(--space-8); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
}
.coin-badge {
  font-size: var(--text-caption); color: var(--gold); font-weight: 600; background: var(--gold-light);
  padding: var(--space-2) var(--space-8); border-radius: var(--radius-lg);
}

/* Hero CTA */
.hero-cta {
  background: linear-gradient(135deg, #C4A06A 0%, #D4B88A 100%);
  border-radius: var(--radius-md); padding: 48rpx var(--space-20);
  text-align: center; margin: var(--space-4) 0 var(--space-12);
  box-shadow: 0 8rpx 32rpx rgba(196,160,106,0.25);
  transition: transform 0.12s;
}
.hero-cta:active { transform: scale(0.97); box-shadow: 0 4rpx 16rpx rgba(196,160,106,0.15); }
.cta-icon { font-size: 56rpx; display: block; margin-bottom: var(--space-8); }
.cta-title { font-size: var(--text-hero); font-weight: 600; color: #FFF; display: block; letter-spacing: 2rpx; }
.cta-desc { font-size: var(--text-body); color: rgba(255,255,255,0.75); display: block; margin-top: var(--space-4); font-weight: 400; }

/* Daily practice card */
.daily-card {
  background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16);
  margin-bottom: var(--space-12); box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--gold);
  transition: transform 0.12s;
}
.daily-card:active { transform: scale(0.97); }
.daily-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-8); }
.daily-label { font-size: var(--text-caption); color: var(--gold); font-weight: 600; letter-spacing: 2rpx; display: block; }
.daily-path { font-size: var(--text-caption); color: var(--text-tertiary); display: block; }
.daily-title { font-size: var(--text-body-large); font-weight: 600; color: var(--text); display: block; }
.daily-subtitle { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-2); }
.daily-arrow { font-size: var(--text-caption); color: var(--gold); display: block; margin-top: var(--space-8); font-weight: 500; }

/* Recommendation */
.rec-strip {
  display: flex; align-items: center; gap: var(--space-8);
  background: var(--primary-light); border-radius: var(--radius-sm);
  padding: var(--space-8) var(--space-12); margin-bottom: var(--space-12);
  transition: transform 0.12s;
}
.rec-strip:active { transform: scale(0.97); }
.rec-strip-icon { font-size: var(--space-16); }
.rec-strip-info { flex: 1; }
.rec-strip-title { font-size: var(--text-body); font-weight: 500; color: var(--text); display: block; }
.rec-strip-desc { font-size: var(--text-caption); color: var(--text-secondary); display: block; margin-top: var(--space-1); }
.rec-strip-go { font-size: var(--space-16); color: var(--gold); }

/* Tool grid */
.tool-grid { display: flex; gap: var(--space-8); margin-bottom: var(--space-16); }
.tool-btn {
  flex: 1; background: var(--card); border-radius: var(--radius-sm);
  padding: var(--space-20) var(--space-8); text-align: center; box-shadow: var(--shadow-sm);
  box-sizing: border-box; transition: transform 0.12s;
}
.tool-btn:active { transform: scale(0.97); box-shadow: var(--shadow-md); }
.tool-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 50%; display: flex;
  align-items: center; justify-content: center; font-size: 40rpx;
  margin: 0 auto var(--space-8); transition: transform 0.12s;
}
.tool-icon-wrap.green { background: var(--accent-green); }
.tool-icon-wrap.gold { background: var(--gold-light); }
.tool-icon-wrap.purple { background: #F0ECF5; }
.tool-icon-wrap.peach { background: var(--accent-peach); }
.tool-label { font-size: var(--text-body); color: var(--text-secondary); display: block; }

/* Quote */
.quote-strip {
  background: var(--card); border-radius: var(--radius-sm);
  padding: var(--space-12) var(--space-16); margin-bottom: var(--space-24);
  border-left: 6rpx solid var(--gold-light);
  display: flex; gap: var(--space-4); align-items: flex-start;
}
.quote-mark { font-size: var(--text-headline); color: var(--gold); opacity: 0.3; line-height: 1; display: block; }
.quote-body { font-size: var(--text-body); color: var(--text-secondary); line-height: 1.9; display: block; font-style: italic; }

/* Check-in banner -- inline, non-blocking */
.checkin-banner {
  display: flex; align-items: center; gap: var(--space-12);
  background: var(--primary-light); border-radius: var(--radius-sm);
  padding: var(--space-12) var(--space-16); margin: var(--space-4) 0 var(--space-12);
  border-left: 6rpx solid var(--gold);
  animation: fadeInUp 0.35s ease-out both;
  transition: transform 0.12s;
}
.checkin-banner:active { transform: scale(0.97); }
.checkin-banner-icon { font-size: var(--space-20); }
.checkin-banner-info { flex: 1; }
.checkin-banner-title { font-size: var(--text-body); font-weight: 500; color: var(--text); display: block; }
.checkin-banner-desc { font-size: var(--text-caption); color: var(--text-secondary); display: block; margin-top: var(--space-1); }
.checkin-banner-arrow { font-size: var(--space-16); color: var(--gold); }
