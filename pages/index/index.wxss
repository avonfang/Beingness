/* Home page — simplified */
.container { min-height: 100vh; padding: 0 32rpx; display: flex; flex-direction: column; }

/* Header bar */
.header-bar { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 0 24rpx; }
.logo-word { font-size: 36rpx; font-weight: 600; color: var(--text); letter-spacing: 4rpx; }
.header-right { display: flex; align-items: center; gap: 20rpx; }
.streak-badge { font-size: 26rpx; color: var(--text-tertiary); }
.coin-badge { font-size: 26rpx; color: var(--gold); font-weight: 500; }

/* Hero CTA */
.hero-cta {
  background: linear-gradient(135deg, #C4A06A 0%, #D4B88A 100%);
  border-radius: 28rpx; padding: 56rpx 40rpx; text-align: center;
  margin: 20rpx 0 24rpx; box-shadow: 0 8rpx 32rpx rgba(196, 160, 106, 0.25);
}
.hero-cta:active { opacity: 0.92; }
.cta-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.cta-title { font-size: 40rpx; font-weight: 600; color: #FFF; display: block; }
.cta-desc { font-size: 28rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }
.cta-arrow { display: inline-block; margin-top: 24rpx; font-size: 28rpx; color: #FFF; font-weight: 500; background: rgba(255,255,255,0.2); padding: 8rpx 32rpx; border-radius: 32rpx; }

/* Recommendation strip */
.rec-strip { display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-sm); border: 2rpx solid var(--gold-light); }
.rec-strip:active { opacity: 0.9; }
.rec-strip-icon { font-size: 32rpx; }
.rec-strip-info { flex: 1; }
.rec-strip-title { font-size: 26rpx; font-weight: 500; color: var(--text); display: block; }
.rec-strip-desc { font-size: 24rpx; color: var(--text-secondary); display: block; margin-top: 4rpx; }
.rec-strip-go { font-size: 32rpx; color: var(--gold); }

/* Tool grid — 2x2 */
.tool-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 32rpx; }
.tool-btn { width: calc(50% - 8rpx); background: var(--card); border-radius: 20rpx; padding: 32rpx 20rpx; text-align: center; box-shadow: var(--shadow-sm); box-sizing: border-box; }
.tool-btn:active { opacity: 0.85; }
.tool-icon { font-size: 40rpx; display: block; margin-bottom: 8rpx; }
.tool-label { font-size: 26rpx; color: var(--text-secondary); display: block; }

/* Quote */
.quote-strip { background: var(--card); border-radius: 20rpx; padding: 28rpx 32rpx; margin-bottom: 48rpx; border-left: 6rpx solid var(--gold-light); display: flex; gap: 12rpx; align-items: flex-start; }
.quote-mark { font-size: 36rpx; color: var(--gold); opacity: 0.3; line-height: 1; display: block; }
.quote-body { font-size: 28rpx; color: var(--text-secondary); line-height: 1.9; display: block; font-style: italic; }

/* Check-in modal */
.checkin-overlay { position: fixed; inset: 0; z-index: 998; background: rgba(29,26,19,0.6); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8rpx); }
.checkin-card { background: #FFF; border-radius: 32rpx; width: 560rpx; padding: 64rpx 48rpx 48rpx; text-align: center; box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.15); }
.checkin-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.checkin-title { font-size: 40rpx; font-weight: 600; color: #1D1A13; display: block; }
.checkin-desc { font-size: 28rpx; color: #8A8478; display: block; margin-top: 12rpx; }
.checkin-streak { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 24rpx; }
.streak-fire { font-size: 32rpx; }
.streak-text { font-size: 28rpx; color: #C4A06A; font-weight: 500; }
.checkin-actions { margin-top: 40rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.checkin-btn { background: #C4A06A; color: #FFF; border-radius: 48rpx; padding: 24rpx 0; width: 100%; text-align: center; font-size: 30rpx; font-weight: 500; }
.checkin-btn:active { opacity: 0.85; }
.checkin-skip { font-size: 26rpx; color: #C4C0B8; padding: 8rpx 0; }
.checkin-skip:active { opacity: 0.7; }