/* 首页 — Figma Make 设计还原 */
.container {
  min-height: 100vh;
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
  background: #F9F5EF;
}

/* ====== Header ====== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 48rpx 0 24rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
  letter-spacing: 1rpx;
}
.header-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
}
.header-notif {
  width: 48rpx;
  height: 48rpx;
  background: #FFD700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 8rpx;
}
.header-notif-icon { font-size: 24rpx; }

/* ====== 情绪按钮 ====== */
.emotion-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 0 0 24rpx;
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.emotion-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #FFF;
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  min-width: 140rpx;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 0.2s, box-shadow 0.2s;
  border: 2rpx solid transparent;
}
.emotion-btn:active { transform: scale(0.95); }
.emotion-btn.active {
  border-color: #D4A76A;
  box-shadow: 0 4rpx 16rpx rgba(212, 167, 106, 0.2);
}
.emotion-emoji {
  font-size: 44rpx;
  display: block;
  line-height: 1;
}
.emotion-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  display: block;
}
.emotion-btn.active .emotion-label { color: #333; }

/* ====== 今日练习 ====== */
.today-card {
  background: linear-gradient(135deg, #E8CBA0, #D4A76A);
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}
.today-card:active { transform: scale(0.98); }
.today-content { flex: 1; }
.today-badge {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  letter-spacing: 2rpx;
}
.today-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
  margin-top: 12rpx;
  line-height: 1.3;
}
.today-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-top: 8rpx;
}
.today-btn {
  display: inline-flex;
  background: #FFF;
  border-radius: 40rpx;
  padding: 14rpx 32rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #D4A76A;
  font-weight: 600;
}
.today-btn:active { opacity: 0.8; }
.today-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(76, 175, 80, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-start;
}
.today-icon-text { font-size: 36rpx; }

/* ====== SOS 情绪急救 ====== */
.sos-card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.sos-card:active { transform: scale(0.98); }
.sos-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}
.sos-tag {
  background: #FF4D4F;
  color: #FFF;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.sos-info { flex: 1; }
.sos-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.sos-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
.sos-arrow {
  font-size: 32rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ====== 为你推荐 ====== */
.recommend-section { margin-bottom: 24rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.rec-card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.rec-card:active { transform: scale(0.98); }

.rec-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 36rpx;
}
.rec-icon-morning { background: #FFE4B5; }
.rec-icon-release { background: #E8F5E9; }

.rec-info { flex: 1; min-width: 0; }
.rec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.rec-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
.rec-duration {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

/* ====== 底部 ====== */
.bottom-spacer { height: 40rpx; }
