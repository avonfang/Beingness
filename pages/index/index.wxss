/* Home page v7 — 极简 */
.container { min-height: 100vh; padding: 0 var(--space-20) calc(100rpx + env(safe-area-inset-bottom) + var(--space-20)); display: flex; flex-direction: column; }

/* Header */
.header-bar { display: flex; align-items: center; justify-content: space-between; padding: var(--space-16) 0 var(--space-8); }
.logo-word { font-size: var(--text-headline); font-weight: 700; color: var(--text); letter-spacing: 2rpx; }
.logo-sub { font-weight: 400; opacity: 0.5; font-size: var(--text-body); letter-spacing: 1rpx; }

/* Hero — 只有一个按钮 */
.hero-section {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding-bottom: 20vh;
  animation: fadeUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
.hero-icon { font-size: 80rpx; display: block; margin-bottom: var(--space-16); }

.start-btn {
  width: 280rpx; height: 280rpx; border-radius: 50%;
  background: var(--primary); color: #FFF;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx var(--primary-subtle);
  transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  margin-bottom: var(--space-32);
}
.start-btn:active { transform: scale(0.92); }
.start-btn-label { font-size: var(--text-title); font-weight: 600; letter-spacing: 2rpx; }

.chill-link {
  display: block; text-align: center;
  font-size: var(--text-body); color: var(--text-tertiary);
  padding: var(--space-8) var(--space-16);
  transition: color 0.2s ease;
}
.chill-link:active { color: var(--text-secondary); }
