/* Home page */
.container { min-height: 100vh; padding: 0 36rpx; display: flex; flex-direction: column; }

.ambient-section { padding: 100rpx 0 48rpx; text-align: center; }
.logo-chinese { font-size: 72rpx; font-weight: 300; color: var(--text); letter-spacing: 24rpx; display: block; }
.logo-sub { font-size: 28rpx; color: var(--text-tertiary); letter-spacing: 8rpx; display: block; margin-top: 20rpx; }
.divider { width: 48rpx; height: 2rpx; background: var(--gold); opacity: 0.4; margin: 28rpx auto 0; border-radius: 2rpx; }

.coins-bar { display: flex; justify-content: center; align-items: center; gap: 8rpx; margin-top: 36rpx; }
.coins-icon { font-size: 26rpx; color: var(--gold); }
.coins-amount { font-size: 30rpx; color: var(--gold); font-weight: 600; }
.coins-label { font-size: 26rpx; color: var(--text-tertiary); }
.streak-divider { font-size: 26rpx; color: var(--border); margin: 0 8rpx; }
.streak-indicator { font-size: 26rpx; color: var(--text-tertiary); }

.entry-card { background: var(--card); border-radius: var(--radius-lg); padding: 56rpx 40rpx; text-align: center; box-shadow: var(--shadow-md); margin-bottom: 28rpx; }
.entry-icon { font-size: 60rpx; display: block; margin-bottom: 24rpx; }
.entry-title { font-size: 40rpx; font-weight: 500; color: var(--text); display: block; }
.entry-desc { font-size: 28rpx; color: var(--text-secondary); display: block; margin-top: 12rpx; }
.entry-arrow { display: inline-block; margin-top: 28rpx; font-size: 30rpx; color: var(--primary); font-weight: 500; }
.entry-card:active { opacity: 0.95; }

.quick-actions { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.quick-btn { flex: 1; background: var(--card); border-radius: var(--radius-md); padding: 36rpx 16rpx; text-align: center; box-shadow: var(--shadow-sm); }
.quick-btn:active { opacity: 0.9; }
.quick-btn-icon { font-size: 44rpx; display: block; }
.quick-btn-label { font-size: 26rpx; color: var(--text-secondary); display: block; margin-top: 12rpx; }

.quote-card { background: var(--card); border-radius: var(--radius-lg); padding: 40rpx 36rpx; box-shadow: var(--shadow-sm); border-left: 6rpx solid var(--primary-light); }
.quote-mark { font-size: 40rpx; color: var(--gold); opacity: 0.3; line-height: 1; display: block; }
.quote-text { font-size: 30rpx; color: var(--text-secondary); line-height: 2; display: block; margin-top: 8rpx; font-style: italic; }
.quote-source { font-size: 26rpx; color: var(--text-tertiary); display: block; margin-top: 16rpx; text-align: right; }

/* Check-in modal */
.checkin-overlay { position: fixed; inset: 0; z-index: 998; background: rgba(29,26,19,0.6); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8rpx); }
.checkin-card { background: #FFF; border-radius: 32rpx; width: 560rpx; padding: 64rpx 48rpx 48rpx; text-align: center; box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.15); }
.checkin-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.checkin-title { font-size: 40rpx; font-weight: 600; color: #1D1A13; display: block; }
.checkin-desc { font-size: 28rpx; color: #8A8478; display: block; margin-top: 12rpx; }
.checkin-streak { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 24rpx; }
.streak-fire { font-size: 32rpx; }
.streak-text { font-size: 28rpx; color: #C4A06A; font-weight: 500; }
.checkin-actions { margin-top: 40rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.checkin-btn { background: #C4A06A; color: #FFF; border-radius: 48rpx; padding: 24rpx 0; width: 100%; text-align: center; font-size: 30rpx; font-weight: 500; }
.checkin-btn:active { opacity: 0.85; }
.checkin-skip { font-size: 26rpx; color: #C4C0B8; padding: 8rpx 0; }
.checkin-skip:active { opacity: 0.7; }
