/* Home page v5 — 极简情绪入口 */
.container { min-height: 100vh; padding: 0 var(--space-16); display: flex; flex-direction: column; }

/* Header */
.header-bar { display: flex; align-items: center; justify-content: space-between; padding: var(--space-16) 0 var(--space-12); }
.logo-word { font-size: var(--text-headline); font-weight: 600; color: var(--text); letter-spacing: 4rpx; }
.header-right { display: flex; align-items: center; gap: var(--space-8); }
.streak-badge {
  font-size: var(--text-caption); color: var(--text-secondary); background: var(--card);
  padding: var(--space-2) var(--space-8); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
}
.coin-badge {
  font-size: var(--text-caption); color: var(--gold); font-weight: 600; background: var(--gold-light);
  padding: var(--space-2) var(--space-8); border-radius: var(--radius-lg);
}

/* Mood hero — 取代旧的 hero-cta */
.mood-hero { text-align: center; padding: var(--space-24) 0 var(--space-16); animation: fadeInUp 0.35s ease-out both; }
.mood-icon { font-size: 72rpx; display: block; margin-bottom: var(--space-8); }
.mood-question { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; letter-spacing: 2rpx; }

/* Emotion quick tags — 4 宫格 */
.emotion-tags { display: flex; gap: var(--space-8); margin-bottom: var(--space-16); animation: fadeInUp 0.35s ease-out 0.05s both; }
.emotion-tag {
  flex: 1; background: var(--card); border-radius: var(--radius-sm); padding: var(--space-12) var(--space-4);
  text-align: center; box-shadow: var(--shadow-sm); transition: transform 0.12s; box-sizing: border-box;
}
.emotion-tag:active { transform: scale(0.95); }
.emotion-tag-icon { font-size: 40rpx; display: block; margin-bottom: var(--space-4); }
.emotion-tag-label { font-size: var(--text-caption); color: var(--text-secondary); display: block; font-weight: 500; }

/* Quick actions — 呼吸 + 写信 */
.quick-actions { display: flex; gap: var(--space-8); margin-bottom: var(--space-16); animation: fadeInUp 0.35s ease-out 0.1s both; }
.quick-action {
  flex: 1; background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16);
  display: flex; align-items: center; gap: var(--space-8); justify-content: center;
  box-shadow: var(--shadow-sm); transition: transform 0.12s;
}
.quick-action:active { transform: scale(0.97); }
.quick-action-icon { font-size: var(--space-16); }
.quick-action-label { font-size: var(--text-body); color: var(--text-secondary); font-weight: 500; }

/* Daily practice card — compact */
.daily-card {
  background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16);
  margin-bottom: var(--space-12); box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--gold);
  transition: transform 0.12s;
}
.daily-card:active { transform: scale(0.97); }
.daily-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-8); }
.daily-label { font-size: var(--text-caption); color: var(--gold); font-weight: 600; letter-spacing: 2rpx; display: block; }
.daily-path { font-size: var(--text-caption); color: var(--text-tertiary); display: block; }
.daily-title { font-size: var(--text-body-large); font-weight: 600; color: var(--text); display: block; }
.daily-subtitle { font-size: var(--text-body); color: var(--text-secondary); display: block; margin-top: var(--space-2); }
.daily-card.locked { opacity: 0.7; }
.daily-premium-badge { font-size: 18rpx; color: var(--gold); background: var(--gold-light); padding: 2rpx 10rpx; border-radius: 8rpx; font-weight: 500; }

/* Recommendation */
.rec-strip {
  display: flex; align-items: center; gap: var(--space-8);
  background: var(--primary-light); border-radius: var(--radius-sm);
  padding: var(--space-8) var(--space-12); margin-bottom: var(--space-12);
  transition: transform 0.12s;
}
.rec-strip:active { transform: scale(0.97); }
.rec-strip-icon { font-size: var(--space-16); }
.rec-strip-info { flex: 1; }
.rec-strip-title { font-size: var(--text-body); font-weight: 500; color: var(--text); display: block; }
.rec-strip-desc { font-size: var(--text-caption); color: var(--text-secondary); display: block; margin-top: var(--space-1); }
.rec-strip-go { font-size: var(--space-16); color: var(--gold); }

/* Shop overlay */
.shop-overlay {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(29, 26, 19, 0.7);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(12rpx);
  opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
}
.shop-overlay.visible { opacity: 1; pointer-events: auto; }
.shop-card {
  background: var(--card); border-radius: var(--radius-md);
  width: 600rpx; padding: var(--space-32) var(--space-24) var(--space-16);
  box-shadow: var(--shadow-lg); text-align: center;
}
.shop-title { font-size: var(--text-headline); font-weight: 600; color: var(--text); display: block; }
.shop-balance { font-size: var(--text-body); color: var(--text-secondary); display: block; margin: var(--space-4) 0 var(--space-20); }
.shop-item {
  display: flex; align-items: center; gap: var(--space-12);
  padding: var(--space-12); border-radius: var(--radius-sm);
  margin-bottom: var(--space-8); background: var(--bg);
  transition: transform 0.12s;
}
.shop-item:active { transform: scale(0.97); }
.shop-item.owned { opacity: 0.6; }
.shop-item-icon { font-size: 40rpx; display: block; }
.shop-item-info { flex: 1; text-align: left; }
.shop-item-name { font-size: var(--text-body); font-weight: 500; color: var(--text); display: block; }
.shop-item-desc { font-size: var(--text-caption); color: var(--text-tertiary); display: block; }
.shop-item-price { font-size: var(--text-body); color: var(--gold); font-weight: 600; }
.shop-item-owned { font-size: var(--text-caption); color: var(--text-tertiary); }
