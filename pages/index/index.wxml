<onboarding-guide wx:if="{{!hasSeenOnboarding}}" bind:finish="onOnboardingFinish" />
<transition-guide wx:elif="{{showTransitionGuide}}" streakDays="{{streakDays}}" bind:finish="onTransitionFinish" />

<view class="container {{themeClass}}">
  <view class="header-bar">
    <text class="logo-word">此刻<text class="logo-sub"> · Being</text></text>
  </view>

  <view class="hero-section">
    <text class="hero-icon">🧘</text>
    <view class="start-btn" bindtap="startSession" hover-class="none">
      <text class="start-btn-label">开始</text>
    </view>
    <view class="chill-link" bindtap="goBreath" hover-class="none">
      <text>不想做任何事，就想呆一会儿</text>
    </view>
  </view>
</view>
