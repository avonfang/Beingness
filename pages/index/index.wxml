<view class="container">

  <!-- ====== Header ====== -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">此刻 · Being</text>
      <text class="header-subtitle">今天，你想关注哪种情绪？</text>
    </view>
    <view class="header-notif" bindtap="goProfile">
      <text class="header-notif-icon">🔔</text>
    </view>
  </view>

  <!-- ====== 情绪选择 ====== -->
  <scroll-view class="emotion-scroll" scroll-x enable-flex>
    <view
      class="emotion-btn {{selectedEmotion === 'anxiety' ? 'active' : ''}}"
      data-emotion="anxiety"
      bindtap="onEmotionTap"
    >
      <text class="emotion-emoji">😮‍💨</text>
      <text class="emotion-label">焦虑</text>
    </view>
    <view
      class="emotion-btn {{selectedEmotion === 'anger' ? 'active' : ''}}"
      data-emotion="anger"
      bindtap="onEmotionTap"
    >
      <text class="emotion-emoji">😤</text>
      <text class="emotion-label">愤怒</text>
    </view>
    <view
      class="emotion-btn {{selectedEmotion === 'low' ? 'active' : ''}}"
      data-emotion="low"
      bindtap="onEmotionTap"
    >
      <text class="emotion-emoji">😔</text>
      <text class="emotion-label">低落</text>
    </view>
    <view
      class="emotion-btn {{selectedEmotion === 'tangled' ? 'active' : ''}}"
      data-emotion="tangled"
      bindtap="onEmotionTap"
    >
      <text class="emotion-emoji">🌀</text>
      <text class="emotion-label">纠结</text>
    </view>
  </scroll-view>

  <!-- ====== 今日练习 ====== -->
  <view class="today-card" bindtap="goEmergency">
    <view class="today-content">
      <text class="today-badge">今日练习</text>
      <text class="today-title">3分钟情绪安抚</text>
      <text class="today-desc">呼吸引导 · 渐进放松</text>
      <view class="today-btn">
        <text>开始练习 →</text>
      </view>
    </view>
    <view class="today-icon">
      <text class="today-icon-text">🌿</text>
    </view>
  </view>

  <!-- ====== 情绪急救 (SOS) ====== -->
  <view class="sos-card" bindtap="goEmergency">
    <view class="sos-left">
      <view class="sos-tag">
        <text>SOS</text>
      </view>
      <view class="sos-info">
        <text class="sos-title">情绪急救</text>
        <text class="sos-desc">当你感到难以坚持的时候</text>
      </view>
    </view>
    <text class="sos-arrow">→</text>
  </view>

  <!-- ====== 为你推荐 ====== -->
  <view class="recommend-section">
    <text class="section-title">为你推荐</text>

    <view class="rec-card" bindtap="onRecommendTap" data-path="presence" data-index="0">
      <view class="rec-icon rec-icon-morning">
        <text>🌅</text>
      </view>
      <view class="rec-info">
        <text class="rec-name">晨间冥想</text>
        <text class="rec-desc">开启平静的一天</text>
      </view>
      <text class="rec-duration">5分钟</text>
    </view>

    <view class="rec-card" bindtap="onRecommendTap" data-path="openness" data-index="1">
      <view class="rec-icon rec-icon-release">
        <text>🌿</text>
      </view>
      <view class="rec-info">
        <text class="rec-name">释放压力</text>
        <text class="rec-desc">让紧绷慢慢松开</text>
      </view>
      <text class="rec-duration">8分钟</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-spacer"></view>

</view>
