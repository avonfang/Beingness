<onboarding-guide wx:if="{{!hasSeenOnboarding}}" bind:finish="onOnboardingFinish" />

<view class="container">
  <!-- Minimal header -->
  <view class="header-bar">
    <text class="logo-word">此刻</text>
    <view class="header-right">
      <text class="streak-badge">🔥 {{streakDays}}天</text>
      <text class="coin-badge">✦ {{awakeningCoins}}</text>
    </view>
  </view>

  <!-- Daily check-in banner — inline, non-blocking -->
  <view class="checkin-banner" wx:if="{{showCheckIn}}" bindtap="doCheckIn">
    <text class="checkin-banner-icon">🌅</text>
    <view class="checkin-banner-info">
      <text class="checkin-banner-title">签到</text>
      <text class="checkin-banner-desc" wx:if="{{streakDays > 0}}">连续 {{streakDays}} 天</text>
      <text class="checkin-banner-desc" wx:else>新的一天，从觉察开始</text>
    </view>
    <text class="checkin-banner-arrow">→</text>
  </view>

  <!-- Hero CTA — 此刻最重要的事 -->
  <view class="hero-cta fade-in" bindtap="startEmergency">
    <text class="cta-icon">🌿</text>
    <text class="cta-title">心里有什么事吗？</text>
    <text class="cta-desc">和我说说，我陪你一起看看</text>
  </view>

  <!-- Recommended lesson -->
  <view class="rec-strip" wx:if="{{recommendation}}" bindtap="goRecommendLesson">
    <text class="rec-strip-icon">💡</text>
    <view class="rec-strip-info">
      <text class="rec-strip-title">{{recommendation.title}}</text>
      <text class="rec-strip-desc">{{recommendation.desc}}</text>
    </view>
    <text class="rec-strip-go">→</text>
  </view>

  <!-- Quick tools -->
  <view class="tool-grid fade-in-d1">
    <view class="tool-btn" bindtap="goBreath">
      <view class="tool-icon-wrap green">🌬️</view>
      <text class="tool-label">呼吸</text>
    </view>
    <view class="tool-btn" bindtap="goDialogue">
      <view class="tool-icon-wrap gold">💬</view>
      <text class="tool-label">对话</text>
    </view>
    <view class="tool-btn" bindtap="goProfile">
      <view class="tool-icon-wrap peach">📊</view>
      <text class="tool-label">报告</text>
    </view>
  </view>

  <!-- Daily quote (below fold) -->
  <view class="quote-strip fade-in-d2">
    <text class="quote-mark">"</text>
    <text class="quote-body">{{dailyQuote}}</text>
  </view>
</view>
