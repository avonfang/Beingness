<onboarding-guide wx:if="{{!hasSeenOnboarding}}" bind:finish="onOnboardingFinish" />

<!-- Daily check-in modal -->
<view class="checkin-overlay" wx:if="{{showCheckIn}}">
  <view class="checkin-card">
    <text class="checkin-icon">🌅</text>
    <text class="checkin-title">早安，觉醒者</text>
    <text class="checkin-desc">新的一天，从觉察开始</text>
    <view class="checkin-streak" wx:if="{{streakDays > 0}}">
      <text class="streak-fire">🔥</text>
      <text class="streak-text">连续 {{streakDays}} 天</text>
    </view>
    <view class="checkin-actions">
      <view class="btn btn-primary btn-lg" bindtap="doCheckIn">今日签到</view>
      <view class="checkin-skip btn btn-ghost btn-sm" bindtap="skipCheckIn">跳过</view>
    </view>
  </view>
</view>

<view class="container">
  <!-- Minimal header -->
  <view class="header-bar">
    <text class="logo-word">此刻</text>
    <view class="header-right">
      <text class="streak-badge">🔥 {{streakDays}}天</text>
      <text class="coin-badge">✦ {{awakeningCoins}}</text>
    </view>
  </view>

  <!-- Hero CTA — the one thing to do -->
  <view class="hero-cta" bindtap="startEmergency">
    <text class="cta-icon">🌿</text>
    <text class="cta-title">现在感觉怎么样？</text>
    <text class="cta-desc">情绪来的时候，试着观察它</text>
    <text class="cta-arrow">开始引导 →</text>
  </view>

  <!-- Recommended lesson -->
  <view class="rec-strip" wx:if="{{recommendation}}" bindtap="goRecommendLesson">
    <text class="rec-strip-icon">💡</text>
    <view class="rec-strip-info">
      <text class="rec-strip-title">{{recommendation.title}}</text>
      <text class="rec-strip-desc">{{recommendation.desc}}</text>
    </view>
    <text class="rec-strip-go">→</text>
  </view>

  <!-- Quick tools -->
  <view class="tool-grid">
    <view class="tool-btn" bindtap="goBreath">
      <text class="tool-icon">🌬️</text>
      <text class="tool-label">呼吸</text>
    </view>
    <view class="tool-btn" bindtap="goDialogue">
      <text class="tool-icon">💬</text>
      <text class="tool-label">对话</text>
    </view>
    <view class="tool-btn" bindtap="goLearning">
      <text class="tool-icon">📖</text>
      <text class="tool-label">学习</text>
    </view>
    <view class="tool-btn" bindtap="goProfile">
      <text class="tool-icon">📊</text>
      <text class="tool-label">报告</text>
    </view>
  </view>

  <!-- Daily quote (below fold) -->
  <view class="quote-strip">
    <text class="quote-mark">"</text>
    <text class="quote-body">{{dailyQuote}}</text>
  </view>
</view>
