<view class="container">
  <view class="page-header">
    <text class="page-title">情绪日志</text>
    <text class="page-subtitle">回顾你的内在旅程</text>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty-state">
    <text class="empty-icon">🌱</text>
    <text class="empty-text">还没有记录</text>
    <text class="empty-hint">完成一次急救或呼吸练习，第一条记录就会出现在这里</text>
    <view class="empty-actions" style="margin-top: var(--space-16);">
      <view class="btn btn-primary btn-md" bindtap="goEmergency">开始急救</view>
      <view class="btn btn-outline btn-md" style="margin-top: var(--space-8);" bindtap="goBreath">呼吸练习</view>
    </view>
  </view>

  <view wx:else class="timeline">
    <view class="day-group" wx:for="{{list}}" wx:key="date">
      <text class="day-label">{{item.date}}</text>

      <!-- Mood entry -->
      <view class="entry-card mood-entry" wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" wx:if="{{entry.type !== 'dialogue'}}">
        <view class="entry-header">
          <text class="entry-emoji">{{entry.emotionIcon}}</text>
          <text class="entry-type">{{entry.emotionLabel}}</text>
          <text class="entry-time">{{entry.time}}</text>
        </view>
        <view class="entry-details">
          <text class="entry-badge" wx:if="{{entry.recoveryMinutes}}">平复 {{entry.recoveryMinutes}} 分钟</text>
          <text class="entry-badge" wx:if="{{entry.rating}}">{{entry.stars}}</text>
        </view>
        <text class="entry-note" wx:if="{{entry.note}}">{{entry.note}}</text>
      </view>

      <!-- Dialogue entry -->
      <view class="entry-card dialogue-entry" wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" wx:if="{{entry.type === 'dialogue'}}">
        <view class="entry-header">
          <text class="entry-emoji">💬</text>
          <text class="entry-type">深度对话</text>
          <text class="entry-time">{{entry.time}}</text>
        </view>
        <text class="entry-dialogue-preview">{{entry.preview}}</text>
        <view class="entry-details">
          <text class="entry-badge">{{entry.messageCount}} 条消息</text>
        </view>
      </view>
    </view>
  </view>
</view>
