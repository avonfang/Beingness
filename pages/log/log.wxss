/* Log v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-icon { font-size: 88rpx; display: block; opacity: 0.6; }
.empty-text { font-size: var(--space-16); color: var(--text-secondary); margin-top: var(--space-12); display: block; }
.empty-hint { font-size: var(--text-body); color: var(--text-tertiary); margin-top: var(--space-4); display: block; }

.timeline { padding-bottom: var(--space-24); }
.day-group { margin-bottom: var(--space-24); }
.day-label {
  font-size: var(--text-caption); color: var(--text-tertiary); display: block;
  margin-bottom: var(--space-12); font-weight: 600; letter-spacing: 2rpx;
  padding-left: var(--space-4);
}

/* Entry — 纯阴影无边框，左边色条 */
.entry-card {
  background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16);
  margin-bottom: var(--space-8); box-shadow: var(--shadow-sm);
  border-left: 8rpx solid var(--gold-light);
  transition: transform 0.15s, box-shadow 0.15s;
  animation: fadeInUp 0.3s ease-out both;
}
.entry-card:active { transform: scale(0.99); box-shadow: var(--shadow-md); }
.entry-card.dialogue-entry { border-left-color: #B8D4BE; }

.entry-header { display: flex; align-items: center; gap: var(--space-8); }
.entry-emoji { font-size: var(--space-20); display: block; line-height: 1; }
.entry-type { font-size: var(--text-body-large); color: var(--text); font-weight: 500; display: block; }
.entry-time { font-size: var(--text-caption); color: var(--text-tertiary); margin-left: auto; display: block; }

.entry-details { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-8); }
.entry-badge { font-size: var(--text-caption); color: var(--primary); background: var(--primary-light); padding: var(--space-2) var(--space-12); border-radius: var(--radius-lg); display: inline-block; }
.entry-note { font-size: var(--text-body); color: var(--text-secondary); line-height: 1.8; display: block; margin-top: var(--space-8); padding: var(--space-8) var(--space-12); background: var(--bg); border-radius: var(--radius-sm); }
.entry-dialogue-preview { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-8); padding: var(--space-8) var(--space-12); background: #F0F7F0; border-radius: var(--radius-sm); }
