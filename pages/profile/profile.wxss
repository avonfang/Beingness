/* Profile v2 */
.container { min-height: 100vh; padding: 0 36rpx; }

/* Hero */
.hero-card {
  background: linear-gradient(135deg, #1D1A13 0%, #3D3528 100%);
  border-radius: var(--radius-lg); padding: 52rpx 40rpx;
  margin: 40rpx 0 36rpx; color: #FFF; position: relative; overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}
.hero-card::after { content: '🧘'; position: absolute; right: -10rpx; bottom: -20rpx; font-size: 160rpx; opacity: 0.08; }
.hero-greeting { font-size: 28rpx; opacity: 0.7; display: block; }
.hero-name { font-size: 48rpx; font-weight: 600; display: block; margin-top: 8rpx; }
.hero-streak { font-size: 28rpx; opacity: 0.7; display: block; margin-top: 12rpx; }

/* Milestone */
.milestone-card {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--card); border-radius: var(--radius-md);
  padding: 32rpx 36rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm); transition: transform 0.15s;
}
.milestone-card:active { transform: scale(0.99); }
.milestone-card.next { background: var(--bg); border: 2rpx dashed var(--border); }
.milestone-emoji { font-size: 48rpx; display: block; }
.milestone-info { flex: 1; }
.milestone-label { font-size: 30rpx; font-weight: 600; color: var(--text); display: block; }
.milestone-desc { font-size: 26rpx; color: var(--text-tertiary); display: block; margin-top: 4rpx; }

/* Coins */
.coins-section { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; display: flex; align-items: center; gap: 28rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.coins-icon-bg { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--gold-light); display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.coins-info { flex: 1; }
.coins-amount { font-size: 52rpx; font-weight: 700; color: var(--gold); display: block; line-height: 1; }
.coins-rule { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-top: 8rpx; }

/* Shop */
.shop-card { background: var(--card); border-radius: var(--radius-md); padding: 32rpx 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.shop-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--border-light); }
.shop-icon { font-size: 32rpx; width: 40rpx; text-align: center; }
.shop-desc { flex: 1; font-size: 28rpx; color: var(--text); }
.shop-cost { font-size: 26rpx; color: var(--gold); font-weight: 500; }
.shop-note { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-top: 16rpx; text-align: center; }

/* Stats grid */
.stats-grid { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.stat-card { flex: 1; background: var(--card); border-radius: var(--radius-md); padding: 32rpx 20rpx; text-align: center; box-shadow: var(--shadow-sm); transition: transform 0.15s; }
.stat-card:active { transform: scale(0.97); }
.stat-num { font-size: 44rpx; font-weight: 600; color: var(--text); display: block; }
.stat-label { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-top: 8rpx; }

/* Emotion card */
.emotion-card { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.card-title { font-size: 26rpx; color: var(--text-tertiary); font-weight: 600; letter-spacing: 2rpx; display: block; margin-bottom: 28rpx; }
.bar-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.bar-label { width: 80rpx; font-size: 26rpx; color: var(--text); font-weight: 500; display: block; }
.bar-track { flex: 1; height: 14rpx; background: var(--border); border-radius: 7rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 7rpx; transition: width 0.5s ease; }
.bar-count { font-size: 24rpx; color: var(--text-tertiary); width: 60rpx; text-align: right; display: block; }

/* Trend card */
.trend-card { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.trend-bars { display: flex; align-items: flex-end; justify-content: center; gap: 48rpx; padding: 40rpx 0; }
.trend-col { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.trend-bar { width: 80rpx; background: var(--gold); border-radius: 12rpx 12rpx 0 0; display: flex; align-items: flex-start; justify-content: center; padding-top: 12rpx; min-height: 40rpx; transition: height 0.5s ease; }
.trend-bar.prev { background: var(--border); }
.trend-num { font-size: 28rpx; color: #FFF; font-weight: 600; }
.trend-label { font-size: 26rpx; color: var(--text-tertiary); }
.trend-arrow { font-size: 48rpx; padding-bottom: 20rpx; }

/* Week report */
.week-report-card { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.report-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid var(--border-light); }
.report-row:last-child { border-bottom: none; }
.report-label { font-size: 28rpx; color: var(--text-secondary); }
.report-value { font-size: 28rpx; color: var(--text); font-weight: 500; }
.report-value.up { color: #D4786A; }
.report-value.down { color: var(--gold); }

/* Achievements */
.achievements-card { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }
.achievement-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.achievement-item { display: flex; align-items: center; gap: 8rpx; background: var(--bg); border-radius: 32rpx; padding: 12rpx 24rpx; }
.achieve-icon { font-size: 28rpx; }
.achieve-label { font-size: 24rpx; color: var(--text); }

/* Insight */
.insight-card { background: var(--card); border-radius: var(--radius-md); padding: 36rpx; margin-bottom: 48rpx; box-shadow: var(--shadow-sm); border-left: 6rpx solid var(--gold-light); }
.insight-text { font-size: 30rpx; color: var(--text-secondary); line-height: 2; display: block; white-space: pre-line; }
