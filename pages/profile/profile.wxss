/* Profile v4 */
.container { min-height: 100vh; padding: 0 var(--space-16); }

/* Hero — 用深色渐变凸显层级 */
.hero-card {
  background: linear-gradient(135deg, #1D1A13 0%, #3D3528 100%);
  border-radius: var(--radius-md); padding: var(--space-24) var(--space-20);
  margin: var(--space-20) 0 var(--space-16); color: #FFF; position: relative; overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}
.hero-card::after { content: '🧘'; position: absolute; right: -10rpx; bottom: -20rpx; font-size: 160rpx; opacity: 0.08; }
.hero-greeting { font-size: var(--text-body); opacity: 0.7; display: block; }
.hero-name { font-size: var(--text-hero); font-weight: 600; display: block; margin-top: var(--space-2); }
.hero-streak { font-size: var(--text-body); opacity: 0.7; display: block; margin-top: var(--space-4); }

/* Milestone — 无边框纯阴影 */
.milestone-card { display: flex; align-items: center; gap: var(--space-12); background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16); margin-bottom: var(--space-8); box-shadow: var(--shadow-sm); }
.milestone-card.next { background: var(--bg); border: 2rpx dashed var(--border); box-shadow: none; }
.milestone-emoji { font-size: var(--space-24); display: block; }
.milestone-label { font-size: var(--text-body-large); font-weight: 600; color: var(--text); display: block; }
.milestone-desc { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-1); }

/* Coins */
.coins-section { background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16); display: flex; align-items: center; gap: var(--space-12); margin-bottom: var(--space-16); box-shadow: var(--shadow-sm); }
.coins-icon-bg { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--gold-light); display: flex; align-items: center; justify-content: center; font-size: var(--space-20); flex-shrink: 0; }
.coins-amount { font-size: var(--text-hero); font-weight: 700; color: var(--gold); display: block; line-height: 1; }
.coins-rule { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-2); }

/* Shop card */
.shop-card { background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16); margin-bottom: var(--space-16); box-shadow: var(--shadow-sm); }
.shop-row { display: flex; align-items: center; gap: var(--space-8); padding: var(--space-8) 0; border-bottom: 2rpx solid var(--border-light); }
.shop-icon { font-size: var(--space-16); width: var(--space-20); text-align: center; }
.shop-desc { flex: 1; font-size: var(--text-body); color: var(--text); }
.shop-cost { font-size: var(--text-caption); color: var(--gold); font-weight: 500; }
.shop-note { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-8); text-align: center; }

/* Stats */
.stats-grid { display: flex; gap: var(--space-8); margin-bottom: var(--space-16); }
.stat-card { flex: 1; background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16) var(--space-8); text-align: center; box-shadow: var(--shadow-sm); }
.stat-num { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; }
.stat-label { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-top: var(--space-2); }

/* Cards */
.emotion-card, .trend-card, .week-report-card, .achievements-card, .insight-card {
  background: var(--card); border-radius: var(--radius-sm); padding: var(--space-16);
  margin-bottom: var(--space-16); box-shadow: var(--shadow-sm);
}
.card-title { font-size: var(--text-caption); color: var(--text-tertiary); font-weight: 600; letter-spacing: 2rpx; display: block; margin-bottom: var(--space-12); }

/* Emotion bars */
.bar-row { display: flex; align-items: center; gap: var(--space-8); margin-bottom: var(--space-12); }
.bar-label { width: 80rpx; font-size: var(--text-caption); color: var(--text); font-weight: 500; display: block; }
.bar-track { flex: 1; height: 14rpx; background: var(--border); border-radius: 7rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 7rpx; transition: width 0.5s ease; }
.bar-count { font-size: var(--text-caption); color: var(--text-tertiary); width: 60rpx; text-align: right; display: block; }

/* Trend */
.trend-bars { display: flex; align-items: flex-end; justify-content: center; gap: var(--space-24); padding: var(--space-20) 0; }
.trend-col { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); }
.trend-bar { width: 80rpx; background: var(--gold); border-radius: var(--space-4) var(--space-4) 0 0; display: flex; align-items: flex-start; justify-content: center; padding-top: 12rpx; min-height: var(--space-20); }
.trend-bar.prev { background: var(--border); }
.trend-num { font-size: var(--text-body); color: #FFF; font-weight: 600; }
.trend-label { font-size: var(--text-caption); color: var(--text-tertiary); }
.trend-arrow { font-size: var(--space-24); padding-bottom: var(--space-8); }

/* Report */
.report-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-8) 0; border-bottom: 2rpx solid var(--border-light); }
.report-row:last-child { border-bottom: none; }
.report-label { font-size: var(--text-body); color: var(--text-secondary); }
.report-value { font-size: var(--text-body); color: var(--text); font-weight: 500; }
.report-value.up { color: #D4786A; }
.report-value.down { color: var(--gold); }

/* Achievements */
.achievement-grid { display: flex; flex-wrap: wrap; gap: var(--space-8); }
.achievement-item { display: flex; align-items: center; gap: var(--space-2); background: var(--bg); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-12); }
.achieve-icon { font-size: var(--space-12); }
.achieve-label { font-size: var(--text-caption); color: var(--text); }

/* Insight */
.insight-card { border-left: 6rpx solid var(--gold-light); }
.insight-text { font-size: var(--text-body); color: var(--text-secondary); line-height: 2; display: block; white-space: pre-line; }
