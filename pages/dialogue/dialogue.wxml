<view class="container">
  <!-- Header -->
  <view class="chat-header">
    <view class="chat-back" bindtap="goBack">
      <text class="chat-back-icon">←</text>
    </view>
    <text class="chat-header-icon">🧘</text>
    <text class="chat-header-title">深度对话</text>
    <text class="chat-header-coins">✦ {{coins}}</text>
  </view>

  <!-- Messages -->
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <view class="coin-notice">
      <text class="coin-notice-text">每次深度对话消耗 3 觉醒币</text>
    </view>

    <!-- Welcome message -->
    <view class="msg-row assistant" id="msg-0">
      <view class="msg-avatar assistant">🧘</view>
      <view class="msg-content">
        <view class="welcome-bubble">
          <text class="msg-text">你好。我在这里——不是给你答案，而是陪你一起看清。</text>
          <text class="msg-text" wx:if="{{coins >= 3}}">今天想聊聊什么？</text>
          <text class="msg-text coins-low" wx:if="{{coins < 3}}">你的觉醒币不足，完成急救或课程可以获得更多。</text>
        </view>
      </view>
    </view>

    <!-- History -->
    <view wx:for="{{messages}}" wx:key="index">
      <view class="msg-row {{item.role === 'user' ? 'user' : 'assistant'}}">
        <view class="msg-avatar {{item.role === 'assistant' ? 'assistant' : 'user'}}">
          {{item.role === 'assistant' ? '🧘' : '🙂'}}
        </view>
        <view class="msg-content">
          <text class="msg-text">{{item.content}}</text>
        </view>
      </view>
    </view>

    <!-- Loading -->
    <view class="msg-row assistant" wx:if="{{loading}}">
      <view class="msg-avatar assistant">🧘</view>
      <view class="msg-content">
        <text class="msg-text thinking">...</text>
      </view>
    </view>

    <view id="scroll-bottom"></view>
  </scroll-view>

  <!-- Input -->
  <view class="input-area">
    <input
      class="msg-input"
      type="text"
      placeholder="说说你的感受..."
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      disabled="{{loading || coins < 3}}"
    />
    <button class="send-btn" bindtap="sendMessage" disabled="{{!inputValue.trim() || loading || coins < 3}}">发送</button>
  </view>
</view>
