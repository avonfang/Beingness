<view class="container {{themeClass}}">
  <!-- Header -->
  <view class="letter-header">
    <view class="letter-back" bindtap="goBack">
      <text class="letter-back-icon">←</text>
    </view>
    <text class="letter-header-icon">💌</text>
    <text class="letter-header-title">此刻信箱</text>
    <text class="daily-badge" wx:if="{{!isPremium}}">免费 {{dailyRemaining}}/5</text>
    <text class="daily-badge premium" wx:if="{{isPremium}}">无限</text>
  </view>

  <!-- Compose phase — 写信 -->
  <view class="letter-body" wx:if="{{phase === 'compose'}}">
    <view class="letter-paper">
      <text class="letter-salutation">给此刻的信：</text>
      <text class="letter-guide" wx:if="{{showGuideText && !letterContent}}">今天发生了什么？或者你心里在想什么？</text>
      <textarea
        class="letter-textarea"
        placeholder="说说你此刻的感受……\n不用组织语言，想到什么写什么"
        value="{{letterContent}}"
        bindinput="onInput"
        maxlength="-1"
        auto-height
      />
      <view class="letter-paper-footer">
        <text class="letter-paper-count">{{letterContent.length}} 字</text>
      </view>
    </view>

    <!-- Suggested topics for new users -->
    <view class="letter-suggestions" wx:if="{{!letterContent}}">
      <text class="letter-suggestions-label">不知从何说起？</text>
      <view class="letter-suggestion-tags">
        <view class="suggestion-tag" bindtap="sendQuickMsg" data-msg="最近压力很大，睡不好">
          <text>😰 最近压力很大</text>
        </view>
        <view class="suggestion-tag" bindtap="sendQuickMsg" data-msg="我感觉很累，什么都不想做">
          <text>😔 感觉很累</text>
        </view>
        <view class="suggestion-tag" bindtap="sendQuickMsg" data-msg="我在做一个重要的决定，很纠结">
          <text>🤔 在做重要决定</text>
        </view>
        <view class="suggestion-tag" bindtap="sendQuickMsg" data-msg="有人让我很生气，我忍不了">
          <text>😤 有人让我生气</text>
        </view>
      </view>
    </view>

    <view class="letter-send-area" wx:if="{{letterContent.trim()}}">
      <view class="btn btn-primary btn-md" bindtap="sendLetter">📮 好了，发出去</view>
    </view>

    <!-- Upgrade banner -->
    <view class="upgrade-banner" wx:if="{{showUpgrade}}">
      <text class="upgrade-icon">✦</text>
      <view class="upgrade-info">
        <text class="upgrade-title">今日免费额度已达上限</text>
        <text class="upgrade-desc">订阅后无限使用此刻信箱。每天 5 封免费额度，写完了明天继续。</text>
      </view>
    </view>
  </view>

  <!-- Sent phase — 显示回信 -->
  <view class="letter-body" wx:if="{{phase === 'sent'}}">
    <!-- The letter user sent -->
    <view class="letter-paper sent">
      <text class="letter-salutation">你写给此刻的信：</text>
      <text class="letter-sent-text">{{sentLetter}}</text>
    </view>

    <!-- Reply section -->
    <view class="reply-section">
      <text class="reply-label">回信</text>

      <!-- Empathy messages (shown one by one) -->
      <view class="empathy-msg" wx:if="{{currentReplyIndex >= 0}}">
        <text class="empathy-text">{{replyParts[0]}}</text>
      </view>
      <view class="empathy-msg" wx:if="{{currentReplyIndex >= 1}}">
        <text class="empathy-text">{{replyParts[1]}}</text>
      </view>
      <view class="empathy-msg" wx:if="{{currentReplyIndex >= 2}}">
        <text class="empathy-text">{{replyParts[2]}}</text>
      </view>

      <!-- Loading dots while generating reply -->
      <text class="empathy-loading" wx:if="{{loading && currentReplyIndex >= 2}}">. . .</text>

      <!-- Full reply -->
      <view class="reply-content" wx:if="{{reply}}">
        <text class="reply-text">{{reply}}</text>
      </view>

      <!-- Practice recommendation -->
      <view class="practice-recommend" wx:if="{{recommendedPractice && reply}}">
        <view class="practice-recommend-divider">推荐练习</view>
        <view class="practice-recommend-btn" bindtap="goPractice">
          <text class="practice-recommend-icon">🌬️</text>
          <text class="practice-recommend-label">{{recommendedPractice.label}}</text>
          <text class="practice-recommend-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- Actions after reading -->
    <view class="letter-actions" wx:if="{{reply}}">
      <view class="btn btn-outline btn-md" bindtap="writeAnother">再写一封</view>
      <view class="btn btn-primary btn-md" bindtap="goBack">完成</view>
    </view>
  </view>
</view>
