.container {
  display: flex; flex-direction: column; height: 100vh; background: #FAFAF8;
}
.msg-list { flex: 1; padding: 20rpx 30rpx; overflow-y: auto; }
.coin-notice { text-align: center; margin-bottom: 20rpx; }
.coin-notice-text { font-size: 22rpx; color: #BBB; }

.msg-row { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.msg-row.user { flex-direction: row-reverse; }
.msg-avatar {
  width: 60rpx; height: 60rpx; border-radius: 50%; background: #F0F7F4;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
  flex-shrink: 0;
}
.user-avatar { background: #F5F0F0; }
.msg-content {
  max-width: 70%; background: #FFF; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.msg-row.user .msg-content { background: #F0F7F4; }
.msg-text { font-size: 28rpx; color: #3D3D3D; line-height: 1.8; display: block; white-space: pre-wrap; }
.coins-low { color: #D4786A; }
.thinking { color: #CCC; }

.input-area {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 30rpx; border-top: 2rpx solid #F0F0F0; background: #FFF;
}
.msg-input {
  flex: 1; height: 72rpx; background: #F5F5F5; border-radius: 36rpx;
  padding: 0 28rpx; font-size: 28rpx;
}
.send-btn {
  width: 120rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  background: #4A7C6F; color: #FFF; border-radius: 36rpx; font-size: 28rpx;
  padding: 0;
}
.send-btn[disabled] { background: #CCC; }
