/* Dialogue v4 — 无气泡边框，纯阴影 */
.container { display: flex; flex-direction: column; height: 100vh; }

.chat-header {
  display: flex; align-items: center; gap: var(--space-4);
  padding: var(--space-12) var(--space-16); background: var(--card);
  border-bottom: 2rpx solid var(--border-light);
  animation: fadeInUp 0.3s ease-out both;
}
.chat-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-left: -12rpx; }
.chat-back-icon { font-size: var(--space-16); color: var(--text-secondary); }
.chat-back:active { opacity: 0.6; }
.chat-header-icon { font-size: var(--text-body-large); }
.chat-header-title { font-size: var(--text-body-large); font-weight: 500; color: var(--text); flex: 1; }
.chat-header-coins { font-size: var(--text-caption); color: var(--gold); }

.msg-list { flex: 1; padding: var(--space-12) var(--space-16); overflow-y: auto; }

/* Messages — 无边框气泡 */
.msg-row { display: flex; gap: var(--space-8); margin-bottom: var(--space-20); }
.msg-row.user { flex-direction: row-reverse; }

.msg-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--text-headline); flex-shrink: 0;
}
.msg-avatar.assistant { background: var(--primary-light); }
.msg-avatar.user { background: var(--accent-peach); }

.msg-content {
  max-width: 72%; background: var(--bg); border-radius: var(--radius-md);
  padding: var(--space-16); box-shadow: var(--shadow-sm);
}
.msg-row.user .msg-content { background: var(--primary-light); }
.msg-row.assistant .msg-content { background: #FBF9F5; }

.msg-text {
  font-size: var(--text-body); color: var(--text); line-height: 1.9;
  display: block; white-space: pre-wrap;
}
.coins-low { color: #D4786A; }
.thinking { color: var(--text-tertiary); animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
.welcome-bubble { font-size: var(--text-body); color: var(--text-secondary); line-height: 1.9; }

/* Suggestions */
.suggestions { text-align: center; margin-bottom: var(--space-16); }
.suggestions-label { font-size: var(--text-caption); color: var(--text-tertiary); display: block; margin-bottom: var(--space-8); }
.suggestion-tags { display: flex; flex-wrap: wrap; gap: var(--space-8); justify-content: center; }
.suggestion-tag {
  background: var(--card); border-radius: var(--radius-lg);
  padding: var(--space-8) var(--space-12); font-size: var(--text-body);
  color: var(--text-secondary); box-shadow: var(--shadow-sm);
  transition: transform 0.12s;
}
.suggestion-tag:active { transform: scale(0.95); }

/* Emotion badge */
.emotion-badge { text-align: center; margin-bottom: var(--space-12); }
.badge-text {
  display: inline-block; font-size: var(--text-caption);
  color: var(--primary); background: var(--gold-light);
  padding: var(--space-2) var(--space-12); border-radius: var(--radius-lg);
}

/* Input area */
.input-area {
  display: flex; align-items: center; gap: var(--space-8);
  padding: var(--space-12) var(--space-16);
  padding-bottom: calc(var(--space-12) + env(safe-area-inset-bottom));
  background: var(--card); border-top: 2rpx solid var(--border-light);
  animation: fadeInUp 0.3s ease-out 0.1s both;
}
.msg-input {
  flex: 1; height: 80rpx; background: var(--bg);
  border-radius: var(--radius-lg); padding: 0 var(--space-16);
  font-size: var(--text-body); color: var(--text);
  border: 2rpx solid transparent; transition: border-color 0.2s;
}
.msg-input:focus { border-color: var(--primary); }
.send-btn {
  width: 128rpx; height: 80rpx; line-height: 80rpx; text-align: center;
  background: var(--primary); color: #FFF; border-radius: var(--radius-lg);
  font-size: var(--text-body-large); padding: 0; font-weight: 500; border: none;
  transition: transform 0.12s;
}
.send-btn:active { transform: scale(0.95); }
.send-btn[disabled] { background: var(--border); color: var(--text-tertiary); }
