/* 此刻信箱 — 信件式交互 */
.container { display: flex; flex-direction: column; min-height: 100vh; }

/* Header */
.letter-header {
  display: flex; align-items: center; gap: var(--space-4);
  padding: var(--space-12) var(--space-16); background: var(--card);
  border-bottom: 2rpx solid var(--border-light);
  animation: fadeInUp 0.3s ease-out both;
}
.letter-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-left: -12rpx; }
.letter-back-icon { font-size: var(--space-16); color: var(--text-secondary); }
.letter-back:active { opacity: 0.6; }
.letter-header-icon { font-size: var(--text-body-large); }
.letter-header-title { font-size: var(--text-body-large); font-weight: 500; color: var(--text); flex: 1; }
.daily-badge {
  font-size: var(--text-caption); color: var(--text-tertiary); background: var(--bg);
  padding: var(--space-2) var(--space-8); border-radius: var(--radius-lg);
}
.daily-badge.premium { color: var(--gold); background: var(--gold-light); font-weight: 600; }

/* Letter body — scrollable */
.letter-body { flex: 1; padding: var(--space-16); overflow-y: auto; }

/* Letter paper — 信纸风格 */
.letter-paper {
  background: var(--card); border-radius: var(--radius-md);
  padding: var(--space-20); margin-bottom: var(--space-16);
  box-shadow: var(--shadow-sm); position: relative;
}
.letter-paper::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6rpx;
  background: var(--gold); border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.letter-salutation {
  font-size: var(--text-caption); color: var(--text-tertiary);
  display: block; margin-bottom: var(--space-12); letter-spacing: 2rpx;
}
.letter-textarea {
  width: 100%; min-height: 240rpx; font-size: var(--text-body);
  color: var(--text); line-height: 1.9; background: transparent;
  border: none; padding: 0;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
}
.letter-textarea::placeholder { color: var(--text-tertiary); }
.letter-paper-footer { text-align: right; margin-top: var(--space-8); }
.letter-paper-count { font-size: var(--text-caption); color: var(--text-tertiary); }

/* Sent letter */
.letter-paper.sent { background: var(--primary-light); }
.letter-sent-text {
  font-size: var(--text-body); color: var(--text); line-height: 1.9;
  display: block; white-space: pre-wrap;
}

/* Suggestions */
.letter-suggestions { text-align: center; margin-bottom: var(--space-16); }
.letter-suggestions-label {
  font-size: var(--text-caption); color: var(--text-tertiary);
  display: block; margin-bottom: var(--space-8);
}
.letter-suggestion-tags { display: flex; flex-wrap: wrap; gap: var(--space-8); justify-content: center; }
.suggestion-tag {
  background: var(--card); border-radius: var(--radius-lg); border: 2rpx solid var(--border-light);
  padding: var(--space-8) var(--space-12); font-size: var(--text-body);
  color: var(--text-secondary); transition: transform 0.12s;
}
.suggestion-tag:active { transform: scale(0.97); }

/* Send area */
.letter-send-area { text-align: center; margin-bottom: var(--space-16); }

/* Reply section */
.reply-section { margin-bottom: var(--space-16); }
.reply-label {
  font-size: var(--text-caption); color: var(--text-tertiary);
  letter-spacing: 2rpx; display: block; margin-bottom: var(--space-8);
}

/* Empathy messages — 逐字出现 */
.empathy-msg {
  animation: fadeIn 0.3s ease-out both;
  margin-bottom: var(--space-4);
}
.empathy-text {
  font-size: var(--text-body); color: var(--text-secondary); line-height: 1.8;
  display: block; font-style: italic;
}
.empathy-loading {
  font-size: var(--text-body); color: var(--text-tertiary);
  display: block; margin: var(--space-8) 0; letter-spacing: 4rpx;
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

/* Reply content — 完整回信 */
.reply-content {
  background: var(--card); border-radius: var(--radius-md);
  padding: var(--space-20); margin-top: var(--space-12);
  border-left: 6rpx solid var(--gold-light); box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.4s ease-out both;
}
.reply-text {
  font-size: var(--text-body); color: var(--text); line-height: 2;
  display: block; white-space: pre-wrap;
}

/* Practice recommendation */
.practice-recommend { margin-top: var(--space-12); animation: fadeInUp 0.4s ease-out 0.1s both; }
.practice-recommend-divider {
  font-size: var(--text-caption); color: var(--text-tertiary);
  text-align: center; display: block; margin-bottom: var(--space-8);
  position: relative;
}
.practice-recommend-divider::before,
.practice-recommend-divider::after {
  content: '——'; color: var(--border);
}
.practice-recommend-btn {
  display: flex; align-items: center; gap: var(--space-8);
  background: var(--gold-light); border-radius: var(--radius-sm);
  padding: var(--space-12) var(--space-16); transition: transform 0.12s;
}
.practice-recommend-btn:active { transform: scale(0.97); }
.practice-recommend-icon { font-size: var(--space-16); }
.practice-recommend-label { flex: 1; font-size: var(--text-body); color: var(--text); font-weight: 500; }
.practice-recommend-arrow { font-size: var(--space-16); color: var(--gold); }

/* Actions */
.letter-actions { display: flex; gap: var(--space-12); justify-content: center; padding-bottom: var(--space-24); }

/* Upgrade banner */
.upgrade-banner {
  display: flex; align-items: flex-start; gap: var(--space-8);
  background: var(--gold-light); border-radius: var(--radius-sm);
  padding: var(--space-12); margin-bottom: var(--space-12);
  border-left: 6rpx solid var(--gold);
}
.upgrade-icon { font-size: var(--space-16); display: block; line-height: 1.4; }
.upgrade-info { flex: 1; }
.upgrade-title { font-size: var(--text-body); font-weight: 600; color: var(--text); display: block; }
.upgrade-desc { font-size: var(--text-caption); color: var(--text-secondary); display: block; margin-top: var(--space-2); line-height: 1.6; }
