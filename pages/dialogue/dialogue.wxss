/* Dialogue */
.container { display: flex; flex-direction: column; height: 100vh; }

.chat-header { display: flex; align-items: center; gap: 12rpx; padding: 28rpx 36rpx; background: var(--card); border-bottom: 2rpx solid var(--border); }
.chat-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-left: -12rpx; }
.chat-back-icon { font-size: 32rpx; color: var(--text-secondary); }
.chat-back:active { opacity: 0.6; }
.chat-header-icon { font-size: 30rpx; }
.chat-header-title { font-size: 30rpx; font-weight: 500; color: var(--text); flex: 1; }
.chat-header-coins { font-size: 26rpx; color: var(--gold); }

.msg-list { flex: 1; padding: 24rpx 36rpx; overflow-y: auto; }
.coin-notice { text-align: center; margin-bottom: 36rpx; margin-top: 12rpx; }
.coin-notice-text { font-size: 24rpx; color: var(--text-tertiary); background: var(--card); padding: 8rpx 28rpx; border-radius: 24rpx; }

.msg-row { display: flex; gap: 20rpx; margin-bottom: 40rpx; }
.msg-row.user { flex-direction: row-reverse; }
.msg-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.msg-avatar.assistant { background: var(--primary-light); }
.msg-avatar.user { background: var(--accent-peach); }

.msg-content { max-width: 72%; background: var(--card); border-radius: 28rpx; padding: 32rpx; box-shadow: var(--shadow-sm); border: 2rpx solid var(--border); }
.msg-row.user .msg-content { background: var(--primary-light); border-color: transparent; }
.msg-text { font-size: 30rpx; color: var(--text); line-height: 1.9; display: block; white-space: pre-wrap; }
.coins-low { color: #D4786A; }
.thinking { color: var(--text-tertiary); }
.welcome-bubble { font-size: 28rpx; color: var(--text-secondary); line-height: 1.9; }

/* Suggestions */
.suggestions { text-align: center; margin-bottom: 36rpx; }
.suggestions-label { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-bottom: 16rpx; }
.suggestion-tags { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; }
.suggestion-tag { background: var(--card); border: 2rpx solid var(--border); border-radius: 32rpx; padding: 16rpx 28rpx; font-size: 26rpx; color: var(--text-secondary); }
.suggestion-tag:active { border-color: var(--gold); color: var(--gold); }

/* Emotion badge */
.emotion-badge { text-align: center; margin-bottom: 24rpx; }
.badge-text { display: inline-block; font-size: 24rpx; color: var(--primary); background: var(--gold-light); padding: 8rpx 28rpx; border-radius: 24rpx; }

.input-area { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 36rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--card); border-top: 2rpx solid var(--border); }
.msg-input { flex: 1; height: 80rpx; background: var(--bg); border-radius: 40rpx; padding: 0 36rpx; font-size: 30rpx; color: var(--text); border: 2rpx solid transparent; }
.msg-input:focus { border-color: var(--primary); }
.send-btn { width: 128rpx; height: 80rpx; line-height: 80rpx; text-align: center; background: var(--primary); color: #FFF; border-radius: 40rpx; font-size: 30rpx; padding: 0; font-weight: 500; border: none; }
.send-btn:active { opacity: 0.85; }
.send-btn[disabled] { background: var(--border); color: var(--text-tertiary); }
