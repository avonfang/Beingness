/* ====================================
   此刻 · Design System v4
   Apple 8pt grid · 纯净 · 一致
   ==================================== */

page {
  /* Colors */
  --bg: #F7F7F7;
  --card: #FFFFFF;
  --primary: #C4A06A;
  --primary-dark: #A07D4A;
  --primary-light: #F5EEDC;
  --gold: #C4A06A;
  --gold-light: #F0E6D0;
  --accent-green: #EBF8F1;
  --accent-peach: #FFEDE0;

  --text: #1D1A13;
  --text-secondary: #6B665A;
  --text-tertiary: #9A958A;

  --border: #E0DDD8;
  --border-light: #EDEBE6;
  --accent-warm-bg: #FFF5F0;
  --accent-warm-text: #C4715A;

  /* Shadows — 只用阴影表达深度，不用边框 */
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.09);
  --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,0.12);

  /* 8pt spacing grid (1pt = 2rpx @ 750 design width) */
  --space-2: 4rpx;    /* 2pt */
  --space-4: 8rpx;    /* 4pt */
  --space-8: 16rpx;   /* 8pt */
  --space-12: 24rpx;  /* 12pt */
  --space-16: 32rpx;  /* 16pt */
  --space-20: 40rpx;  /* 20pt */
  --space-24: 48rpx;  /* 24pt */
  --space-32: 64rpx;  /* 32pt */
  --space-40: 80rpx;  /* 40pt */

  /* Radius — Apple 使用 3 种半径 */
  --radius-sm: 16rpx;   /* 8pt - 卡片内元素 */
  --radius-md: 24rpx;   /* 12pt - 标准卡片 */
  --radius-lg: 40rpx;   /* 20pt - 按钮 / 弹窗 */

  /* Type scale */
  --text-caption: 24rpx;
  --text-body: 28rpx;
  --text-body-large: 30rpx;
  --text-subhead: 32rpx;
  --text-headline: 36rpx;
  --text-title: 44rpx;
  --text-hero: 52rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: var(--text-body-large);
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}

/* Theme packs — accent color override */
.theme-ocean { --primary: #5B8FB9; --primary-dark: #4A7A9E; --primary-light: #D4E8F4; --gold: #5B8FB9; --gold-light: #D4E8F4; }
.theme-forest { --primary: #7A9E7E; --primary-dark: #5E8262; --primary-light: #D8E8DA; --gold: #7A9E7E; --gold-light: #D8E8DA; }

/* Dark mode — 柔和深色，降低视觉疲劳 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #1A1A1A;
    --card: #2A2A2A;
    --primary: #C4A06A;
    --primary-dark: #B8945E;
    --primary-light: #2A241A;
    --gold: #C4A06A;
    --gold-light: #2A241A;
    --accent-green: #1A2A1E;
    --accent-peach: #2A1E1A;

    --text: #EBE8E0;
    --text-secondary: #9A958A;
    --text-tertiary: #6B665A;

    --border: #3A3A3A;
    --border-light: #2E2E2E;
    --accent-warm-bg: #2A1E1A;
    --accent-warm-text: #D48870;

    --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.2);
    --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.3);
    --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,0.4);
  }
}

/* ====================================
   Card — 纯阴影，无边框
   ==================================== */
.card {
  background: var(--card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s, box-shadow 0.15s;
}
.card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* ====================================
   Button system — 3 种变体
   ==================================== */
.btn {
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-lg); border: none;
  font-size: var(--text-body-large); font-weight: 500;
  transition: transform 0.12s, box-shadow 0.12s, background 0.15s;
  box-sizing: border-box;
}
.btn:active { transform: scale(0.97); }

/* Solid primary */
.btn-primary {
  background: var(--primary); color: #FFF;
  box-shadow: 0 4rpx 20rpx rgba(196,160,106,0.25);
}
.btn-primary:active { box-shadow: 0 2rpx 12rpx rgba(196,160,106,0.2); }

/* Outline */
.btn-outline {
  background: transparent; color: var(--primary);
  border: 2rpx solid var(--primary);
}
.btn-outline:active { background: var(--primary-light); }

/* Ghost (最轻量) */
.btn-ghost {
  background: transparent; color: var(--text-tertiary);
  border: 2rpx solid transparent;
}
.btn-ghost:active { color: var(--text-secondary); }

/* Size variants */
.btn-lg { padding: 32rpx 0; width: 100%; }
.btn-md { padding: 24rpx 48rpx; }
.btn-sm { padding: 16rpx 32rpx; font-size: var(--text-body); }
.btn-block { width: 80%; }

/* ====================================
   Utility animations
   ==================================== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes bounceIn {
  0%   { transform: scale(0.6); }
  60%  { transform: scale(1.12); }
  100% { transform: scale(1); }
}
.fade-in { animation: fadeInUp 0.35s ease-out both; }
.fade-in-d1 { animation: fadeInUp 0.35s ease-out 0.08s both; }
.fade-in-d2 { animation: fadeInUp 0.35s ease-out 0.14s both; }
.fade-in-d3 { animation: fadeInUp 0.35s ease-out 0.2s both; }
.bounce-in { animation: bounceIn 0.4s ease-out both; }

/* ====================================
   Section layout
   ==================================== */
.page { min-height: 100vh; padding: 0 var(--space-16); }

.page-header { padding: var(--space-24) 0 var(--space-16); }
.page-title { font-size: var(--text-title); font-weight: 600; color: var(--text); display: block; }
.page-subtitle { font-size: var(--text-body); color: var(--text-tertiary); display: block; margin-top: var(--space-2); }

.section { margin-bottom: var(--space-24); }
.section-title {
  font-size: var(--text-caption); color: var(--text-tertiary);
  letter-spacing: 2rpx; margin-bottom: var(--space-12);
  display: block; font-weight: 600;
}
