/* ====================================
   此刻 · Design System v3
   纯净 · 温暖 · 可读 · 有层
   ==================================== */

page {
  --bg: #F7F7F7;
  --card: #FFFFFF;
  --primary: #C4A06A;
  --primary-dark: #A07D4A;
  --primary-light: #F5EEDC;
  --gold: #C4A06A;
  --gold-light: #F0E6D0;
  --accent-green: #EBF8F1;
  --accent-peach: #FFEDE0;

  --text: #1D1A13;
  --text-secondary: #6B665A;
  --text-tertiary: #9A958A;

  --border: #E0DDD8;
  --border-light: #EDEBE6;

  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.09);
  --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,0.12);
  --shadow-xl: 0 24rpx 64rpx rgba(0,0,0,0.15);

  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}

/* Card base with press effect */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s, box-shadow 0.15s;
}
.card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* Button presets */
.btn-primary {
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-xl);
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: transform 0.12s, box-shadow 0.12s;
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(196, 160, 106, 0.35);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-xl);
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  transition: transform 0.12s;
}
.btn-outline:active {
  transform: scale(0.97);
  background: var(--primary-light);
}

/* Utility: fade-in animation */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fadeInUp 0.35s ease-out both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.fade-in-quick {
  animation: fadeIn 0.2s ease-out both;
}

/* Utility: bounce scale for micro-interactions */
@keyframes bounceIn {
  0%   { transform: scale(0.8); }
  60%  { transform: scale(1.15); }
  100% { transform: scale(1); }
}

/* Section title */
.section { margin-bottom: 48rpx; }
.section-title {
  font-size: 26rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  display: block;
  font-weight: 500;
}
