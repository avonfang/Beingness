/* ====================================
   此刻 · Design System v2
   参考风格：纯净 · 温暖 · 留白
   ==================================== */

page {
  --bg: #F7F7F7;
  --card: #FFFFFF;
  --primary: #C4A06A;
  --primary-dark: #A07D4A;
  --primary-light: #F5EEDC;
  --gold: #C4A06A;
  --gold-light: #F0E6D0;
  --accent-green: #EBF8F1;
  --accent-peach: #FFEDE0;
  --text: #1D1A13;
  --text-secondary: #8A8478;
  --text-tertiary: #C4C0B8;
  --border: #E8E5E0;
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-xl);
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}
.btn-primary:active { opacity: 0.85; }

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-xl);
  padding: 28rpx 48rpx;
  font-size: 32rpx;
}

.section { margin-bottom: 48rpx; }
.section-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  display: block;
}
