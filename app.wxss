/* ====================================
   此刻 · 新设计系统 v7 — 温暖疗愈
   ==================================== */

page {
  --bg-overlay: rgba(255, 248, 240, 0.92);
  --card: rgba(255, 255, 255, 0.85);
  --card-solid: #FFFFFF;
  --primary: #C4A06A;
  --primary-dark: #A07D4A;
  --primary-subtle: rgba(196, 160, 106, 0.12);
  --gold-light: #F5EEDC;
  --text: #4A3B32;
  --text-secondary: #8E7A6E;
  --text-tertiary: #C4B8AE;
  --border: rgba(74, 59, 50, 0.08);
  --shadow-sm: 0 2rpx 12rpx rgba(74, 59, 50, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(74, 59, 50, 0.08);
  --radius-sm: 20rpx;
  --radius-md: 32rpx;
  --radius-lg: 48rpx;

  background: var(--bg-overlay);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 全屏背景图 + 高斯模糊遮罩 */
page::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  /* 替换为你的背景图URL */
  background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1080');
  background-size: cover;
  background-position: center;
  filter: blur(12rpx);
  transform: scale(1.1);
}

/* 衬线标题 */
.serif {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-weight: 600;
}

/* 通用按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-lg); border: none;
  font-weight: 500;
  transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-sizing: border-box;
}
.btn:active { transform: scale(0.96); }

.btn-primary {
  background: var(--primary); color: #FFF;
  box-shadow: 0 4rpx 16rpx rgba(196, 160, 106, 0.3);
}
.btn-primary:active { opacity: 0.85; }

/* 毛玻璃卡片 */
.glass-card {
  background: var(--card);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* 动画 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes breatheIn {
  0% { transform: scale(0.92); opacity: 0.6; }
  50% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(0.92); opacity: 0.6; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.fade-up { animation: fadeUp 0.5s ease both; }
.fade-up-d1 { animation: fadeUp 0.5s ease 0.08s both; }
.fade-up-d2 { animation: fadeUp 0.5s ease 0.14s both; }
.fade-up-d3 { animation: fadeUp 0.5s ease 0.2s both; }
