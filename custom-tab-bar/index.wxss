.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 100;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100%;
  transition: transform 0.15s;
}
.tab-item:active { transform: scale(0.88); }

.tab-icon {
  font-size: 40rpx;
  display: block;
  line-height: 1;
}
.tab-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  font-weight: 500;
  transition: color 0.2s;
}
.tab-item.active .tab-label {
  color: #D4A76A;
  font-weight: 600;
}
