<view class="tab-bar">
  <view
    class="tab-item {{active === index ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="label"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <text class="tab-icon">{{item.icon}}</text>
      <view class="tab-dot" wx:if="{{active === index}}"></view>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
